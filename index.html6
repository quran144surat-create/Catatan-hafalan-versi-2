function persistQ(e){
  return e.mode==='ayat'
    ?{id:e.id,date:e.date,type:e.type,mode:'ayat',ss:e.ss,sa:e.sa,es:e.es,ea:e.ea,ts:e.ts}
    :{id:e.id,date:e.date,type:e.type,sj:e.sj,sp:e.sp,ej:e.ej,ep:e.ep,ts:e.ts};
}
/* Data yang dihitung sekali: indeks ayat global 1..6236 */
const AYTOT=6236;
const CUM=[0];AY.forEach(n=>CUM.push(CUM[CUM.length-1]+n));
const PS=[0].concat(PSTART);
const PE=[0];for(let p=1;p<=604;p++)PE[p]=(p<604?PS[p+1]:AYTOT+1)-1;
const WC=new Uint16Array(AYTOT+2);AWORDS.split(',').forEach((v,i)=>{WC[i+1]=Number(v);});
const CW=new Int32Array(AYTOT+2);for(let g=1;g<=AYTOT;g++)CW[g]=CW[g-1]+WC[g];
const PW=[0];for(let p=1;p<=604;p++)PW[p]=CW[PE[p]]-CW[PS[p]-1];
const gAyah=(s,a)=>CUM[s-1]+a;
function ayahFromG(g){let lo=1,hi=114;while(lo<hi){const m=(lo+hi)>>1;if(CUM[m]>=g)hi=m;else lo=m+1;}return{s:lo,a:g-CUM[lo-1]};}
function pageOfAyah(g){let lo=1,hi=604;while(lo<hi){const m=(lo+hi+1)>>1;if(PS[m]<=g)lo=m;else hi=m-1;}return lo;}
function pageEq(a1,a2){
  let s=0;const p1=pageOfAyah(a1),p2=pageOfAyah(a2);
  for(let p=p1;p<=p2;p++){const lo=Math.max(a1,PS[p]),hi=Math.min(a2,PE[p]);s+=(CW[hi]-CW[lo-1])/PW[p];}
  return s;
}
function deriveQ(e){
  if(e.mode==='ayat'){
    e.a1=gAyah(e.ss,e.sa);e.a2=gAyah(e.es,e.ea);e.ayat=e.a2-e.a1+1;e.pages=pageEq(e.a1,e.a2);
  }else{
    const pa=gp(e.sj,e.sp),pb=gp(e.ej,e.ep);
    e.pa=pa;e.pb=pb;e.a1=PS[pa];e.a2=PE[pb];e.ayat=e.a2-e.a1+1;e.pages=pb-pa+1;
  }
  return e;
}
const fmtN=v=>nf1.format(Math.round(v*10)/10);
function ayatRangeText(s1,a1,s2,a2){
  return s1===s2?SN[s1-1]+' '+a1+(a2!==a1?'–'+a2:''):SN[s1-1]+' '+a1+' sampai '+SN[s2-1]+' '+a2;
}
function gRangeText(g1,g2){const x=ayahFromG(g1),y=ayahFromG(g2);return ayatRangeText(x.s,x.a,y.s,y.a);}
function pageRangeJuz(p1,p2){
  const a=fromGp(p1),b=fromGp(p2);
  return a.j===b.j?'Juz '+a.j+', hal '+a.p+(b.p!==a.p?'–'+b.p:''):'Juz '+a.j+' hal '+a.p+' sampai Juz '+b.j+' hal '+b.p;
}
/* Keadaan hafalan Quran: dihitung dari semua setoran "hafalan baru" pada tingkat ayat */
let memVer=0,memCache=null,memCacheVer=-1;
function mem(){if(memCacheVer!==memVer){memCache=memState();memCacheVer=memVer;}return memCache;}
function memState(){
  const flag=new Uint8Array(AYTOT+2);
  for(const e of S.quran){if(e.type!=='baru')continue;for(let g=e.a1;g<=e.a2;g++)flag[g]=1;}
  const mc=new Int32Array(AYTOT+2),mw=new Int32Array(AYTOT+2);
  for(let g=1;g<=AYTOT;g++){mc[g]=mc[g-1]+flag[g];mw[g]=mw[g-1]+(flag[g]?WC[g]:0);}
  const frac=new Float64Array(605),full=new Uint8Array(605);
  let fullPages=0,pageEqSum=0;
  for(let p=1;p<=604;p++){
    const w=mw[PE[p]]-mw[PS[p]-1];
    frac[p]=w/PW[p];
    if(w===PW[p]){full[p]=1;fullPages++;}
    pageEqSum+=frac[p];
  }
  const juz=[null];let juzDone=0;
  for(let j=1;j<=30;j++){
    const n=juzPages(j);let f=0,fp=0;
    for(let p=1;p<=n;p++){const g=gp(j,p);f+=frac[g];if(full[g])fp++;}
    const done=fp===n;if(done)juzDone++;
    juz.push({n:n,full:fp,eq:f,done:done});
  }
  const sur=[0];
  for(let s=1;s<=114;s++)sur.push(mc[CUM[s]]-mc[CUM[s-1]]);
  return{flag:flag,mc:mc,frac:frac,full:full,fullPages:fullPages,pageEq:pageEqSum,ayat:mc[AYTOT],juz:juz,juzDone:juzDone,sur:sur};
}

/* Ringkasan status per juz (tuntas / berjalan / belum) untuk rapot PDF.
   Memakai mem().juz yang sudah dihitung (n=halaman per juz, full=halaman penuh, done=selesai). */
function buildJuzProgress(){
  const M=mem();
  const rows=[];
  let doneCount=0,ongoingCount=0,noneCount=0;
  for(let j=1;j<=30;j++){
    const jz=M.juz[j];
    const status=jz.done?'tuntas':(jz.full>0?'berjalan':'belum');
    if(status==='tuntas')doneCount++;else if(status==='berjalan')ongoingCount++;else noneCount++;
    rows.push({juz:j,total:jz.n,full:jz.full,pct:jz.n?jz.full/jz.n:0,status:status});
  }
  return{rows:rows,doneCount:doneCount,ongoingCount:ongoingCount,noneCount:noneCount,
    totalPagesFull:M.fullPages,totalPagesAll:TOTAL,juzDone:M.juzDone};
}

/* ---------- Validasi & pembersihan data ---------- */
const DATE_RE=/^\d{4}-\d{2}-\d{2}$/;
function cleanQuran(e){
  if(!e||typeof e!=='object')return null;
  if(!DATE_RE.test(e.date||'')||(e.type!=='baru'&&e.type!=='murajaah'))return null;
  const base={id:String(e.id||uid()),date:e.date,type:e.type,ts:Number(e.ts)||0};
  if(e.mode==='ayat'){
    if(![e.ss,e.sa,e.es,e.ea].every(Number.isInteger))return null;
    if(e.ss<1||e.ss>114||e.es<1||e.es>114||e.sa<1||e.sa>AY[e.ss-1]||e.ea<1||e.ea>AY[e.es-1])return null;
    if(gAyah(e.es,e.ea)<gAyah(e.ss,e.sa))return null;
    return deriveQ(Object.assign(base,{mode:'ayat',ss:e.ss,sa:e.sa,es:e.es,ea:e.ea}));
  }
  if(![e.sj,e.sp,e.ej,e.ep].every(Number.isInteger))return null;
  if(e.sj<1||e.sj>30||e.ej<1||e.ej>30||e.sp<1||e.sp>juzPages(e.sj)||e.ep<1||e.ep>juzPages(e.ej))return null;
  if(gp(e.ej,e.ep)<gp(e.sj,e.sp))return null;
  return deriveQ(Object.assign(base,{sj:e.sj,sp:e.sp,ej:e.ej,ep:e.ep}));
}
function cleanMatan(m){
  if(!m||typeof m!=='object'||typeof m.title!=='string'||!Number.isInteger(m.total)||m.total<1)return null;
  return{id:String(m.id||uid()),title:m.title.slice(0,80),total:m.total,createdAt:Number(m.createdAt)||0};
}
function cleanLog(e,ids){
  if(!e||typeof e!=='object')return null;
  if(!DATE_RE.test(e.date||'')||(e.type!=='baru'&&e.type!=='murajaah'))return null;
  const m=ids.get(String(e.matanId));
  if(!m||!Number.isInteger(e.from)||!Number.isInteger(e.to))return null;
  if(e.from<1||e.to<e.from||e.to>m.total)return null;
  return{id:String(e.id||uid()),matanId:m.id,date:e.date,type:e.type,from:e.from,to:e.to,count:e.to-e.from+1,ts:Number(e.ts)||0};
}
function cleanState(raw){
  let skipped=0;
  const q=[],ml=[],mt=[];
  (Array.isArray(raw.quran)?raw.quran:[]).forEach(e=>{const c=cleanQuran(e);c?q.push(c):skipped++;});
  const ids=new Map();
  (Array.isArray(raw.matan)?raw.matan:[]).forEach(m=>{const c=cleanMatan(m);if(c){mt.push(c);ids.set(c.id,c);}else skipped++;});
  (Array.isArray(raw.matanLog)?raw.matanLog:[]).forEach(e=>{const c=cleanLog(e,ids);c?ml.push(c):skipped++;});
  return{quran:q,matan:mt,matanLog:ml,skipped:skipped};
}
/* ==========================================================================
   URUTAN 2c — Sambungkan skema multi-santri ke loadAll/applyState/flush
   ==========================================================================
   Pendekatan: S TETAP jadi satu-satunya tempat semua layar (Quran, Matan,
   Rekap, dst.) membaca/menulis data — supaya Urutan 4/5 nanti tidak perlu
   mengubah tiap layar satu per satu. S selalu berisi data SANTRI YANG
   SEDANG AKTIF. Di atas S ada MS (MultiState): daftar santri + data semua
   santri. MS null = mode pribadi (perilaku sekarang, tidak berubah).

   Alur: loadAll() mengembalikan bentuk legacy atau multi-santri →
   applyState(d) mendeteksi bentuknya, isi MS bila perlu, lalu salin data
   santri aktif ke S (syncSFromActiveSantri). Sebelum flush/ganti santri
   aktif, S disalin balik ke MS (syncActiveSantriIntoMS) supaya perubahan
   tidak hilang.

   Ketiga metode penyimpanan (local/db/sheets) sudah disambungkan penuh ke
   skema multi-santri (Urutan 3 & 7): masing-masing punya cara sendiri
   menyimpan seluruh santriData sekaligus setiap flush — local ke
   MULTI_SANTRI_KEY, db ke dokumen 'santri-meta' + 'santri__<id>'
   (writeSantriDb), sheets ke sheet 'santriMeta' + 'quran__<id>' dst lewat
   endpoint ?mode=santri (lihat GAS_CODE). Kalau MS null (mode pribadi),
   ketiganya tetap memakai jalur lama seperti sebelum fitur ini ada.

   Opsi "Kelola banyak orang" muncul di onboarding lewat resolveSantriSetup()
   (Urutan 6); sampai pengguna memilihnya, MS tetap null seperti sebelumnya.
   ========================================================================== */
let MS=null; // null = mode pribadi. Objek = mode multi-santri (lihat Urutan 1).

function cleanMultiSantriState(raw){
  const santriData={};
  Object.keys(raw.santriData||{}).forEach(id=>{
    const cleaned=cleanState(raw.santriData[id]||{});
    santriData[id]={quran:cleaned.quran,matan:cleaned.matan,matanLog:cleaned.matanLog};
  });
  const santriList=Array.isArray(raw.santriList)?raw.santriList.filter(s=>s&&s.id&&santriData[s.id]):[];
  let activeId=raw.activeSantriId;
  if(!santriData[activeId])activeId=santriList.length?santriList[0].id:null;
  return {mode:'santri',activeSantriId:activeId,santriList:santriList,santriData:santriData};
}

function syncSFromActiveSantri(){
  // Salin data santri aktif (dari MS) ke S, supaya semua layar yang sudah
  // ada otomatis menampilkan data santri yang sedang dipilih.
  if(!MS)return;
  const rec=MS.santriData[MS.activeSantriId]||emptySantriRecord();
  S.quran=rec.quran;S.matan=rec.matan;S.matanLog=rec.matanLog;
}

function syncActiveSantriIntoMS(){
  // Salin balik isi S ke MS.santriData[activeSantriId] — dipanggil sebelum
  // menyimpan (flush) dan sebelum berganti santri aktif.
  if(!MS)return;
  MS.santriData[MS.activeSantriId]={quran:S.quran,matan:S.matan,matanLog:S.matanLog};
}

function switchActiveSantri(id){
  // Rencana dipakai UI pemilih santri di Urutan 4. Menyimpan dulu perubahan
  // S milik santri sebelumnya ke MS, baru pindah ke santri baru.
  if(!MS||!MS.santriData[id])return false;
  syncActiveSantriIntoMS();
  MS.activeSantriId=id;
  syncSFromActiveSantri();
  memVer++;
  return true;
}

function mapSantriDataForPersist(santriData){
  // Terapkan persistQ (format tanggal khusus penyimpanan) ke data quran tiap
  // santri sebelum ditulis ke localStorage, sama seperti mode pribadi.
  const out={};
  Object.keys(santriData).forEach(id=>{
    const r=santriData[id]||emptySantriRecord();
    out[id]={quran:(r.quran||[]).map(persistQ),matan:r.matan||[],matanLog:r.matanLog||[]};
  });
  return out;
}

function applyState(d){
  if(isMultiSantriState(d)){
    MS=d;
    syncSFromActiveSantri();
  }else{
    MS=null;
    S.quran=d.quran;S.matan=d.matan;S.matanLog=d.matanLog;
  }
  memVer++;
}
/* ========================== akhir rancangan Urutan 2c ==================== */

/* ==========================================================================
   URUTAN 4 — UI pemilih & manajemen santri (mode "Kelola banyak orang")
   ==========================================================================
   Seluruh fungsi di blok ini HANYA aktif kalau MS terisi (pengguna memilih
   "Kelola banyak orang" di onboarding — lihat resolveSantriSetup, Urutan 6).
   Untuk pengguna mode pribadi, MS tetap null, renderSantriBar() langsung
   menyembunyikan bar-nya — tidak ada perubahan tampilan bagi mereka.
   ========================================================================== */
function renderSantriBar(){
  const bar=$('santriBar');
  if(!MS||!MS.santriList.length){bar.hidden=true;return;}
  bar.hidden=false;
  $('santriSelect').innerHTML=MS.santriList.map(s=>
    '<option value="'+esc(s.id)+'"'+(s.id===MS.activeSantriId?' selected':'')+'>'+esc(s.nama)+'</option>'
  ).join('');
}

function onSantriSwitch(id){
  if(!MS||id===MS.activeSantriId)return;
  if(!switchActiveSantri(id))return;
  ui.qShown=15;ui.mShown=15; // reset paging riwayat utk santri yang baru dipilih
  markDirty('santri-meta');
  renderAll();
  renderSantriBar();
}

let santriEditingId=null;
function renderSantriMgmt(){
  if(!MS)return;
  $('santriMgmtList').innerHTML=MS.santriList.map(s=>{
    if(s.id===santriEditingId){
      return '<div class="mrow" data-sid="'+esc(s.id)+'">'
        +'<input class="input" data-sd-edit value="'+esc(s.nama)+'" maxlength="40">'
        +'<div class="row-actions"><button class="btn small" type="button" data-sd-save>Simpan</button><button class="btn ghost small" type="button" data-sd-cancel>Batal</button></div></div>';
    }
    return '<div class="mrow" data-sid="'+esc(s.id)+'">'
      +'<span>'+esc(s.nama)+(s.id===MS.activeSantriId?' <span class="chip baru">Aktif</span>':'')+'</span>'
      +'<div class="row-actions">'
      +'<button class="icon-btn" type="button" data-sd-rename aria-label="Ganti nama santri"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>'
      +'<button class="icon-btn" type="button" data-sd-del aria-label="Hapus santri"'+(MS.santriList.length<=1?' disabled':'')+'><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg></button>'
      +'</div></div>';
  }).join('');
}

/* Tahap 1: santriDlg & mdlg dibuka non-modal (openNonModal) supaya menu
   bawah & tombol lain tetap bisa dipakai selagi dialog ini terbuka — hanya
   dialog & tombol simpannya sendiri yang relevan untuk "terkunci". Dialog
   konfirmasi (dlg, mis. hapus/atasi tumpang tindih) & rapotDlg tetap modal
   penuh seperti semula karena keduanya memang butuh keputusan sebelum
   lanjut, bukan proses input yang bisa ditinggal begitu saja. */
function openNonModal(d){
  $('manualBackdrop').hidden=false;
  d.show();
}
function anyNonModalOpen(){return santriDlg.open||mdlg.open;}
function openSantriMgmt(){
  if(!MS)return;
  santriEditingId=null;
  renderSantriMgmt();
  openNonModal(santriDlg);
}

function saveSantriRename(id){
  if(!MS)return;
  const input=document.querySelector('#santriMgmtList [data-sid="'+id+'"] [data-sd-edit]');
  if(!input)return;
  const nama=input.value.trim();
  if(!nama){toast('Nama tidak boleh kosong');return;}
  const s=MS.santriList.find(x=>x.id===id);
  if(s)s.nama=nama;
  santriEditingId=null;
  markDirty('santri-meta');
  renderSantriMgmt();renderSantriBar();
}

async function deleteSantri(id){
  if(!MS||MS.santriList.length<=1)return;
  const s=MS.santriList.find(x=>x.id===id);if(!s)return;
  const v=await ask({title:'Hapus santri?',body:'Semua data hafalan "'+s.nama+'" akan hilang permanen dari perangkat ini. Tindakan ini tidak bisa dibatalkan.',
    actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Hapus',value:'go',kind:'danger'}]});
  if(v!=='go')return;
  const wasActive=MS.activeSantriId===id;
  const prevActiveId=MS.activeSantriId;
  const sIdx=MS.santriList.indexOf(s);
  const removedData=MS.santriData[id];
  MS.santriList=MS.santriList.filter(x=>x.id!==id);
  delete MS.santriData[id];
  if(wasActive){MS.activeSantriId=MS.santriList[0].id;syncSFromActiveSantri();memVer++;}
  renderSantriMgmt();renderSantriBar();
  if(wasActive)renderAll();
  scheduleUndoableRemoval('santri-'+id,'Santri dihapus',
    ()=>{markDirty('santri-meta');},
    ()=>{
      MS.santriList.splice(sIdx,0,s);
      MS.santriData[id]=removedData;
      if(wasActive){MS.activeSantriId=prevActiveId;syncSFromActiveSantri();memVer++;}
      renderSantriMgmt();renderSantriBar();
      if(wasActive)renderAll();
      markDirty('santri-meta');
    });
}

function addSantriFromDlg(){
  if(!MS)return;
  const input=$('sd-new-name');
  const nama=input.value.trim();
  if(!nama){toast('Isi nama santri dulu');return;}
  MS=addSantri(MS,nama);
  input.value='';
  markDirty('santri-meta');
  renderSantriMgmt();renderSantriBar();
  toast('Santri ditambahkan');
}
/* ========================== akhir rancangan Urutan 4 ==================== */

/* ==========================================================================
   URUTAN 5 — Halaman existing sadar santri aktif
   ==========================================================================
   Beranda/Quran/Matan/Rekap sudah otomatis mengikuti santri aktif karena
   sejak Urutan 3, S selalu berisi data santri yang sedang dipilih. Yang
   masih perlu disesuaikan secara eksplisit di sini hanyalah bagian yang
   memakai "nama pengguna" tingkat perangkat (UserName) — di mode
   multi-santri, nama yang relevan untuk ditampilkan/dicetak adalah nama
   SANTRI AKTIF, bukan nama pemilik perangkat (guru/orang tua).
   ========================================================================== */
function activeDisplayName(){
  if(MS){
    const s=MS.santriList.find(x=>x.id===MS.activeSantriId);
    return s?s.nama:'';
  }
  return UserName||'';
}
/* ========================== akhir rancangan Urutan 5 ==================== */

/* ---------- Metode penyimpanan (authgate) ---------- */
const AG_KEY='catatan-hafalan-authmethod';
function getAuthChoice(){
  try{const t=localStorage.getItem(AG_KEY);return t?JSON.parse(t):null;}catch(e){return null;}
}
function setAuthChoice(v){
  try{localStorage.setItem(AG_KEY,JSON.stringify(v));}catch(e){}
}
function resolveAuthChoice(){
  return new Promise(res=>{
    const saved=getAuthChoice();
    if(saved){res(saved);return;}
    const gate=$('authgate');
    gate.hidden=false;
    $('ag-gas-code').value=GAS_CODE;
    $('ag-gas-copy').addEventListener('click',async()=>{
      try{
        if(navigator.clipboard&&navigator.clipboard.writeText)await navigator.clipboard.writeText(GAS_CODE);
        else{const ta=$('ag-gas-code');ta.focus();ta.select();document.execCommand('copy');}
        toast('Kode disalin');
      }catch(e){
        $('ag-gas-code').focus();$('ag-gas-code').select();
        toast('Gagal menyalin otomatis. Kode sudah dipilih, salin manual (Ctrl/Cmd+C).');
      }
    });
    let done=false;
    function finish(v){
      if(done)return;done=true;
      setAuthChoice(v);
      $('ag-step-storage').hidden=true;
      gate.hidden=true;
      res(v);
    }
    $('ag-main').addEventListener('click',e=>{
      const b=e.target.closest('[data-ag]');if(!b)return;
      if(b.dataset.ag==='none'){finish({method:'none'});return;}
      if(b.dataset.ag==='sheets'){$('ag-main').hidden=true;$('ag-sheets').hidden=false;}
    });
    $('ag-back').addEventListener('click',()=>{$('ag-sheets').hidden=true;$('ag-main').hidden=false;});
    $('ag-manual-save').addEventListener('click',async()=>{
      const url=$('ag-url').value.trim();
      if(!url){toast('Tempel URL Apps Script dulu');return;}
      if(!/^https:\/\//.test(url)){toast('URL harus diawali https://');return;}
      const btn=$('ag-manual-save');
      btn.disabled=true;btn.textContent='Menghubungkan…';
      try{
        Persist.sheetUrl=url;
        await sheetsFetch('GET');
        finish({method:'sheets-manual',sheetUrl:url});
      }catch(e){
        toast('Tidak bisa terhubung ke Sheet. Periksa URL & izin akses, lalu coba lagi.');
        btn.disabled=false;btn.textContent='Simpan & lanjutkan';
      }
    });
    $('ag-skip').addEventListener('click',()=>finish({method:'none'}));
  });
}
const NAME_KEY='catatan-hafalan-username';
let UserName='';
function resolveUserName(){
  return new Promise(res=>{
    let saved=null;
    try{saved=localStorage.getItem(NAME_KEY);}catch(e){saved='';}
    if(saved!==null){UserName=saved;res(saved);return;}
    const gate=$('authgate');
    $('ag-step-storage').hidden=true;
    gate.hidden=false;
    $('ag-step-name').hidden=false;
    function finish(v){
      try{localStorage.setItem(NAME_KEY,v);}catch(e){}
      UserName=v;
      $('ag-step-name').hidden=true;
      gate.hidden=true;
      res(v);
    }
    $('ag-name-save').addEventListener('click',()=>{
      finish($('ag-name-input').value.trim().slice(0,40));
    });
    $('ag-name-skip').addEventListener('click',()=>finish(''));
    $('ag-name-input').addEventListener('keydown',e=>{if(e.key==='Enter')$('ag-name-save').click();});
  });
}
/* ==========================================================================
   URUTAN 6 — Opsi mode di layar onboarding ("Kelola banyak orang")
   ==========================================================================
   Ditanyakan sekali (disimpan di SANTRI_MODE_KEY, sama seperti AG_KEY/
   NAME_KEY). Kalau pengguna pilih "santri", lanjut minta nama santri
   pertama, lalu bentuk state multi-santri lewat addSantri() (Urutan 2b)
   dan disimpan ke PendingFirstSantriMS untuk dipakai boot() menimpa hasil
   loadAll() yang masih kosong. Kalau pengguna pilih "personal", MS tetap
   null seperti perilaku sebelumnya — tidak ada yang berubah untuk mereka.
   ========================================================================== */
function getSantriMode(){
  try{return localStorage.getItem(SANTRI_MODE_KEY);}catch(e){return null;}
}
function setSantriMode(v){
  try{localStorage.setItem(SANTRI_MODE_KEY,v);}catch(e){}
}
let PendingFirstSantriMS=null;
function resolveSantriSetup(){
  return new Promise(res=>{
    const saved=getSantriMode();
    if(saved){res(saved);return;}
    const gate=$('authgate');
    gate.hidden=false;
    $('ag-step-mode').hidden=false;
    $('ag-mode-cards').addEventListener('click',e=>{
      const b=e.target.closest('[data-mode]');if(!b)return;
      const v=b.dataset.mode;
      setSantriMode(v);
      $('ag-step-mode').hidden=true;
      if(v!=='santri'){gate.hidden=true;res(v);return;}
      $('ag-step-santri1').hidden=false;
      function finishSantri(){
        const nama=$('ag-santri1-input').value.trim().slice(0,40)||'Santri 1';
        PendingFirstSantriMS=addSantri(emptyMultiSantriState(),nama);
        $('ag-step-santri1').hidden=true;
        gate.hidden=true;
        res('santri');
      }
      $('ag-santri1-save').addEventListener('click',finishSantri,{once:true});
      $('ag-santri1-input').addEventListener('keydown',function onKey(ev){if(ev.key==='Enter'){ev.preventDefault();finishSantri();}},{once:true});
    });
  });
}
/* ========================== akhir Urutan 6 =============================== */

function changeAuthMethod(){
  try{localStorage.removeItem(AG_KEY);}catch(e){}
  location.reload();
}
function changeUserName(){
  try{localStorage.removeItem(NAME_KEY);}catch(e){}
  location.reload();
}

/* ---------- Penyimpanan ---------- */
const Persist={mode:'memory',col:null,viaChoice:false,sheetUrl:null,sheetEmail:''};
async function sheetsFetch(method,body,qs){
  const opts={method:method};
  if(body!==undefined)opts.body=JSON.stringify(body);
  const res=await fetch(Persist.sheetUrl+(qs||''),opts);
  if(!res.ok)throw new Error('http_'+res.status);
  const data=await res.json();
  if(data&&data.ok===false)throw new Error(data.error||'sheet_error');
  return data;
}
async function initPersist(){
  const c=window.claude;
  if(c&&typeof c.use==='function'){
    try{
      const res=await Promise.all([c.use('db'),c.use('user')]);
      const db=res[0],user=res[1];
      if(db&&user){
        const id=await user.id();
        if(id){Persist.mode='db';Persist.col=db.collection('data/users/'+id);return;}
      }
    }catch(e){}
  }
  Persist.viaChoice=true;
  const choice=await resolveAuthChoice();
  if(choice&&choice.method==='sheets-manual'&&choice.sheetUrl){
    Persist.mode='sheets';Persist.sheetUrl=choice.sheetUrl;return;
  }
  try{localStorage.setItem('__t','1');localStorage.removeItem('__t');Persist.mode='local';}catch(e){Persist.mode='memory';}
}
const DB_SANTRI_PFX='santri__'; // prefiks id dokumen Firestore utk mode "Kelola banyak orang"
async function loadAll(){
  const raw={quran:[],matan:[],matanLog:[]};
  if(Persist.mode==='db'){
    const snap=await Persist.col.get();
    let meta=null;
    const santriData={};
    snap.docs.forEach(d=>{
      const data=d.data()||{},id=d.id;
      if(id==='santri-meta'){meta=data;return;}
      if(id.indexOf(DB_SANTRI_PFX)===0){
        santriData[id.slice(DB_SANTRI_PFX.length)]={
          quran:Array.isArray(data.quran)?data.quran:[],
          matan:Array.isArray(data.matan)?data.matan:[],
          matanLog:Array.isArray(data.matanLog)?data.matanLog:[]
        };
        return;
      }
      if(id==='matan'&&Array.isArray(data.items))raw.matan=data.items;
      else if(id.indexOf('quran-')===0&&Array.isArray(data.entries))raw.quran.push.apply(raw.quran,data.entries);
      else if(id.indexOf('matanlog-')===0&&Array.isArray(data.entries))raw.matanLog.push.apply(raw.matanLog,data.entries);
    });
    if(meta||Object.keys(santriData).length){
      return cleanMultiSantriState({mode:'santri',activeSantriId:meta?meta.activeSantriId:null,santriList:(meta&&Array.isArray(meta.santriList))?meta.santriList:[],santriData:santriData});
    }
  }else if(Persist.mode==='sheets'){
    if(getSantriMode()==='santri'){
      const d=await sheetsFetch('GET',undefined,'?mode=santri');
      Persist.sheetEmail=d.email||'';
      return cleanMultiSantriState({mode:'santri',activeSantriId:d.activeSantriId,santriList:Array.isArray(d.santriList)?d.santriList:[],santriData:d.santriData||{}});
    }
    const d=await sheetsFetch('GET');
    raw.quran=Array.isArray(d.quran)?d.quran:[];
    raw.matan=Array.isArray(d.matan)?d.matan:[];
    raw.matanLog=Array.isArray(d.matanLog)?d.matanLog:[];
    Persist.sheetEmail=d.email||'';
  }else if(Persist.mode==='local'){
    try{
      const mt=localStorage.getItem(MULTI_SANTRI_KEY);
      if(mt){
        const parsedMulti=JSON.parse(mt);
        if(isMultiSantriState(parsedMulti))return cleanMultiSantriState(parsedMulti);
      }
    }catch(e){}
    try{const t=localStorage.getItem(LS_KEY);if(t){const p=JSON.parse(t);raw.quran=p.quran||[];raw.matan=p.matan||[];raw.matanLog=p.matanLog||[];}}catch(e){}
  }
  return cleanState(raw);
}
const dirty=new Set();
let flushing=false,flushTimer=null,saveState='saved',lastErr=null;
/* Tahap 4: bedakan "internet bermasalah" dari error penyimpanan lain, supaya
   pengguna tahu apakah perlu cek koneksi atau ada masalah lain (mis. Sheet
   penuh/rusak). Heuristik: browser melaporkan offline, kode 'unavailable'
   dari withRetry (sudah dicoba ulang sekali dan tetap gagal), atau fetch()
   gagal total (biasanya muncul sebagai TypeError di semua browser modern). */
function isNetworkError(err){
  if(!err)return false;
  if(typeof navigator!=='undefined'&&navigator.onLine===false)return true;
  if(err.code==='unavailable')return true;
  if(err.name==='TypeError')return true;
  return false;
}
function setSave(s,err){
  saveState=s;lastErr=err||null;
  const el=$('status'),t=$('statusT'),r=$('statusRetry');
  let key=s,txt='Tersimpan';
  if(s==='saving')txt='Menyimpan…';
  else if(s==='error'){
    if(err&&err.code==='quota_exceeded'){txt='Penyimpanan penuh';}
    else if(isNetworkError(err)){key='offline';txt='Internet bermasalah';}
    else{txt='Belum tersimpan';}
  }
  else if(Persist.mode==='local'){key='local';txt='Hanya di browser ini';}
  else if(Persist.mode==='memory'){key='memory';txt='Tidak tersimpan';}
  else if(Persist.mode==='sheets'){txt='Tersimpan di Sheet';}
  el.dataset.s=key;t.textContent=txt;r.hidden=s!=='error';
}
function markDirty(){for(let i=0;i<arguments.length;i++)dirty.add(arguments[i]);scheduleFlush();}
function scheduleFlush(){setSave('saving');clearTimeout(flushTimer);flushTimer=setTimeout(flush,350);}
async function writeDoc(id){
  let body,empty=false;
  if(id==='matan'){body={items:S.matan};}
  else if(id.indexOf('quran-')===0){const y=id.slice(6),e=S.quran.filter(x=>x.date.indexOf(y)===0);body={entries:e.map(persistQ)};empty=!e.length;}
  else{const y=id.slice(9),e=S.matanLog.filter(x=>x.date.indexOf(y)===0);body={entries:e};empty=!e.length;}
  const ref=Persist.col.doc(id);
  if(empty)await ref.delete();else await ref.set(body);
}
/* Urutan 7: tulis SELURUH state multi-santri sekaligus (satu dokumen 'santri-meta'
   berisi daftar+santri aktif, satu dokumen 'santri__<id>' per santri berisi
   quran/matan/matanLog-nya). Ditulis utuh setiap flush (bukan per-field seperti
   writeDoc di atas) supaya tidak ada risiko salah sasaran kalau pengguna
   berpindah santri aktif tepat sebelum flush sempat jalan. Dokumen santri yang
   sudah dihapus dari santriList ikut dibuang lewat penanda DB_SANTRI_PFX. */
async function writeSantriDb(){
  await Persist.col.doc('santri-meta').set({activeSantriId:MS.activeSantriId,santriList:MS.santriList});
  const keepIds=new Set(Object.keys(MS.santriData));
  const snap=await Persist.col.get();
  const toDelete=[];
  snap.docs.forEach(d=>{
    const id=d.id;
    if(id.indexOf(DB_SANTRI_PFX)===0&&!keepIds.has(id.slice(DB_SANTRI_PFX.length)))toDelete.push(id);
  });
  for(const id of toDelete)await Persist.col.doc(id).delete();
  const mapped=mapSantriDataForPersist(MS.santriData);
  for(const sid of keepIds){
    const rec=mapped[sid]||{quran:[],matan:[],matanLog:[]};
    await Persist.col.doc(DB_SANTRI_PFX+sid).set(rec);
  }
}
async function withRetry(fn){
  try{return await fn();}
  catch(e){
    if(e&&e.code==='unavailable'){await new Promise(r=>setTimeout(r,700+Math.random()*500));return await fn();}
    throw e;
  }
}
async function flush(){
  if(flushing)return;
  flushing=true;
  try{
    syncActiveSantriIntoMS(); // pastikan perubahan S masuk ke MS sebelum disimpan
    if(Persist.mode==='db'){
      if(MS){
        dirty.clear();
        await withRetry(()=>writeSantriDb());
      }else{
        while(dirty.size){
          const id=dirty.values().next().value;
          dirty.delete(id);
          try{await withRetry(()=>writeDoc(id));}catch(e){dirty.add(id);throw e;}
        }
      }
    }else if(Persist.mode==='sheets'){
      dirty.clear();
      if(MS){
        await withRetry(()=>sheetsFetch('POST',{mode:'santri',activeSantriId:MS.activeSantriId,santriList:MS.santriList,santriData:mapSantriDataForPersist(MS.santriData)}));
      }else{
        await withRetry(()=>sheetsFetch('POST',{quran:S.quran.map(persistQ),matan:S.matan,matanLog:S.matanLog}));
      }
    }else if(Persist.mode==='local'){
      dirty.clear();
      if(MS){
        localStorage.setItem(MULTI_SANTRI_KEY,JSON.stringify(Object.assign({},MS,{santriData:mapSantriDataForPersist(MS.santriData)})));
      }else{
        localStorage.setItem(LS_KEY,JSON.stringify({quran:S.quran.map(persistQ),matan:S.matan,matanLog:S.matanLog}));
      }
    }else dirty.clear();
    setSave('saved');
  }catch(e){setSave('error',e);}
  finally{flushing=false;if(dirty.size&&saveState!=='error')scheduleFlush();}
}
function markAllDirty(oldQ,oldL){
  const ids=new Set(['matan']);
  S.quran.concat(oldQ||[]).forEach(e=>ids.add('quran-'+e.date.slice(0,4)));
  S.matanLog.concat(oldL||[]).forEach(e=>ids.add('matanlog-'+e.date.slice(0,4)));
  ids.forEach(i=>dirty.add(i));
  scheduleFlush();
}
const qDoc=e=>'quran-'+e.date.slice(0,4);
const lDoc=e=>'matanlog-'+e.date.slice(0,4);

/* ---------- Perhitungan ---------- */
function matanInfo(m){
  const mem=new Set(),last={};
  let maxBait=0,maxBaru=0;
  for(const e of S.matanLog){
    if(e.matanId!==m.id)continue;
    if(e.to>maxBait)maxBait=e.to;
    if(e.type==='baru'&&e.to>maxBaru)maxBaru=e.to;
    for(let b=e.from;b<=e.to;b++){
      if(e.type==='baru')mem.add(b);
      if(!last[b]||e.date>last[b])last[b]=e.date;
    }
  }
  const t=todayS();
  const state=b=>{
    if(!mem.has(b))return'belum';
    return(last[b]&&diffDays(last[b],t)>STALE)?'ulang':'hafal';
  };
  let stale=0;
  mem.forEach(b=>{if(state(b)==='ulang')stale++;});
  const count=mem.size;
  const status=count===0?{k:'belum',t:'Belum mulai'}:(count>=m.total?{k:'selesai',t:'Selesai'}:{k:'sedang',t:'Sedang dihafal'});
  return{mem:mem,last:last,count:count,maxBait:maxBait,maxBaru:maxBaru,state:state,stale:stale,status:status};
}
function curMatan(){return S.matan.find(m=>m.id===ui.matanId)||null;}
function streak(){
  const days=new Set();
  S.quran.forEach(e=>days.add(e.date));
  S.matanLog.forEach(e=>days.add(e.date));
  const t=todayS();
  let d=days.has(t)?t:addDays(t,-1),n=0;
  while(days.has(d)){n++;d=addDays(d,-1);}
  return{n:n,today:days.has(t)};
}
function paceOf(list,val){
  if(!list.length)return null;
  const t=todayS();
  let first=list[0].date;
  list.forEach(e=>{if(e.date<first)first=e.date;});
  const span=Math.min(30,Math.max(1,diffDays(first,t)+1));
  const from=addDays(t,-(span-1));
  let sum=0;
  list.forEach(e=>{if(e.date>=from&&e.date<=t)sum+=val(e);});
  return{avg:sum/span,span:span,sum:sum};
}
function humanDur(days){
  if(days<=1)return'1 hari';
  if(days<60)return days+' hari';
  if(days<365)return Math.round(days/30)+' bulan';
  let y=Math.floor(days/365),m=Math.round((days%365)/30);
  if(m>=12){y++;m=0;}
  return y+' tahun'+(m?' '+m+' bulan':'');
}
function etaText(remaining,pace,unit){
  if(remaining<=0)return null;
  if(!pace||pace.span<3)return{ok:false,text:'Catat hafalan baru selama beberapa hari, lalu perkiraan selesai akan muncul di sini.'};
  if(pace.sum<=0)return{ok:false,text:'Belum ada hafalan baru dalam 30 hari terakhir, jadi perkiraan belum bisa dihitung.'};
  const days=Math.ceil(remaining/pace.avg);
  const date=addDays(todayS(),days);
  return{ok:true,date:fmtLong(date),dur:humanDur(days),avg:nf1.format(pace.avg),unit:unit,span:pace.span};
}

/* ---------- Dialog & toast ---------- */
const dlg=$('dlg'),mdlg=$('mdlg'),rapotDlg=$('rapotDlg'),santriDlg=$('santriDlg');
/* Tahap 1: baru sekarang santriDlg & mdlg pasti sudah ada, aman dipasangi
   listener 'close' untuk menyembunyikan manualBackdrop. */
[santriDlg,mdlg].forEach(d=>d.addEventListener('close',()=>{if(!anyNonModalOpen())$('manualBackdrop').hidden=true;}));
[dlg,mdlg,santriDlg].forEach(d=>{if(!d.showModal){d.showModal=function(){d.setAttribute('open','');};d.close=function(){d.removeAttribute('open');d.dispatchEvent(new Event('close'));};}if(!d.show){d.show=function(){d.setAttribute('open','');};}});
let dlgFinish=null;
dlg.addEventListener('cancel',e=>{e.preventDefault();if(dlgFinish)dlgFinish(null);});
function ask(o){
  return new Promise(res=>{
    $('dlgTitle').textContent=o.title;
    $('dlgText').textContent=o.body;
    const box=$('dlgActions');box.innerHTML='';
    let done=false;
    dlgFinish=v=>{if(done)return;done=true;dlgFinish=null;dlg.close();res(v);};
    o.actions.forEach(a=>{
      const b=document.createElement('button');
      b.type='button';b.className='btn '+(a.kind||'');b.textContent=a.label;
      b.addEventListener('click',()=>dlgFinish(a.value));
      box.appendChild(b);
    });
    dlg.showModal();
  });
}
let toastT=null;
function toast(msg){
  const t=$('toast');t.classList.remove('act');t.textContent=msg;t.classList.add('on');
  clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove('on'),2600);
}
/* Tahap 4: toast dengan tombol "Urungkan", dipakai bareng scheduleUndoableRemoval
   di bawah. Menampilkan aksi butuh pointer-events aktif (lihat .toast.act di
   CSS), beda dari toast biasa yang memang tidak bisa diklik. */
function toastUndo(msg,onUndo,ms){
  const t=$('toast');clearTimeout(toastT);
  t.innerHTML='';t.classList.add('act');
  const span=document.createElement('span');span.textContent=msg;t.appendChild(span);
  const b=document.createElement('button');b.type='button';b.className='u';b.textContent='Urungkan';
  b.addEventListener('click',()=>{clearTimeout(toastT);t.classList.remove('on','act');onUndo();});
  t.appendChild(b);
  t.classList.add('on');
  toastT=setTimeout(()=>{t.classList.remove('on','act');},ms||UNDO_MS+500);
}
/* Tahap 4: jeda undo singkat setelah hapus. Item sudah dihapus dari state &
   dirender (feedback instan seperti sebelumnya), tapi commitFn (yang menandai
   dirty/menyimpan) baru dijalankan setelah UNDO_MS berlalu tanpa diurungkan.
   Kalau pengguna menekan "Urungkan", commitFn dibatalkan sama sekali sehingga
   tidak pernah tersinkron ke penyimpanan — restoreFn mengembalikan tampilan. */
const UNDO_MS=6000;
const pendingUndo=new Map();
function scheduleUndoableRemoval(key,msg,commitFn,restoreFn){
  const prev=pendingUndo.get(key);
  if(prev){clearTimeout(prev.timer);prev.commitFn();} // selesaikan yang lama dulu kalau tertumpuk
  const timer=setTimeout(()=>{pendingUndo.delete(key);commitFn();},UNDO_MS);
  pendingUndo.set(key,{timer:timer,commitFn:commitFn});
  toastUndo(msg,()=>{
    const p=pendingUndo.get(key);
    if(!p)return;
    clearTimeout(p.timer);pendingUndo.delete(key);
    restoreFn();
  });
}

/* ---------- Pemilihan bagian Rapot PDF ---------- */
const RAPOT_SEC_KEY='rapotSecPrefs';
const RAPOT_SECTIONS=[
  {key:'cards',label:'Kartu ringkasan & progres khataman'},
  {key:'juz',label:'Peta juz & rincian per juz'},
  {key:'table',label:'Tabel rincian per periode'},
  {key:'quote',label:'Kutipan motivasi'},
  {key:'signature',label:'Area tanda tangan pembimbing'}
];
function loadRapotSecPrefs(){
  let saved=null;
  try{const t=localStorage.getItem(RAPOT_SEC_KEY);if(t)saved=JSON.parse(t);}catch(e){}
  const def={cards:true,juz:true,table:true,quote:false,signature:false};
  return Object.assign(def,saved||{});
}
function saveRapotSecPrefs(v){
  try{localStorage.setItem(RAPOT_SEC_KEY,JSON.stringify(v));}catch(e){}
}
/* Urutan 7: dialog Rapot PDF kini juga menanyakan santri mana saja (kalau mode
   "Kelola banyak orang" aktif dan ada lebih dari 1 santri) sebelum bagian
   laporan seperti biasa. Untuk mode pribadi (MS null) atau santri tunggal,
   bagian pemilih santri disembunyikan dan perilakunya sama seperti sebelumnya. */
function askRapotOptions(){
  return new Promise(res=>{
    const multi=!!(MS&&MS.santriList.length>1);
    $('rpSantriWrap').hidden=!multi;
    if(multi){
      $('rpSantriList').innerHTML=MS.santriList.map(s=>
        '<label><input type="checkbox" class="rp-santri" value="'+esc(s.id)+'"'+(s.id===MS.activeSantriId?' checked':'')+'> '+esc(s.nama)+'</label>'
      ).join('');
    }
    const prefs=loadRapotSecPrefs();
    $('rpSecList').innerHTML=RAPOT_SECTIONS.map(s=>
      '<label><input type="checkbox" id="rps-'+s.key+'"'+(prefs[s.key]?' checked':'')+'> '+esc(s.label)+'</label>'
    ).join('');
    let done=false;
    const finish=v=>{if(done)return;done=true;res(v);};
    $('rp-cancel').onclick=()=>{rapotDlg.close();finish(null);};
    $('rpForm').onsubmit=e=>{
      e.preventDefault();
      let santriIds=null;
      if(multi){
        santriIds=Array.from($('rpSantriList').querySelectorAll('.rp-santri:checked')).map(el=>el.value);
        if(!santriIds.length){toast('Pilih minimal satu santri');return;}
      }
      const sections={};
      RAPOT_SECTIONS.forEach(s=>{sections[s.key]=$('rps-'+s.key).checked;});
      saveRapotSecPrefs(sections);
      rapotDlg.close();finish({sections:sections,santriIds:santriIds});
    };
    rapotDlg.addEventListener('cancel',e=>{e.preventDefault();rapotDlg.close();finish(null);},{once:true});
    rapotDlg.showModal();
  });
}

/* ---------- Navigasi ---------- */
function showView(v){
  // Tahap 1: santriDlg/mdlg non-modal, jadi kalau pengguna pindah tab lewat
  // menu bawah selagi dialog itu masih terbuka, tutup dulu dialognya supaya
  // tidak melayang di atas tampilan baru.
  if(santriDlg.open)santriDlg.close();
  if(mdlg.open)mdlg.close();
  ui.view=v;
  ['dash','quran','matan','rekap'].forEach(k=>{$('v-'+k).hidden=k!==v;});
  document.querySelectorAll('.nav-i').forEach(b=>{
    if(b.dataset.view===v)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');
  });
  if(v==='rekap')renderRekap();
  window.scrollTo(0,0);
}

/* ---------- Beranda ---------- */
function ring(frac,size,stroke,animate){
  const r=(size-stroke)/2,c=2*Math.PI*r,cx=size/2;
  const off=c*(1-Math.min(1,Math.max(0,frac)));
  return'<svg class="ring" width="'+size+'" height="'+size+'" viewBox="0 0 '+size+' '+size+'" aria-hidden="true">'+
    '<circle class="ring-track" cx="'+cx+'" cy="'+cx+'" r="'+r+'" stroke-width="'+stroke+'"/>'+
    (frac>0?'<circle class="ring-bar'+(animate?' anim':'')+'" cx="'+cx+'" cy="'+cx+'" r="'+r+'" stroke-width="'+stroke+'" stroke-dasharray="'+c+'" stroke-dashoffset="'+off+'" style="--c:'+c+'" transform="rotate(-90 '+cx+' '+cx+')"/>':'')+
    '</svg>';
}
function renderDash(){
  const t=todayS(),M=mem();
  const pct=M.pageEq/TOTAL;
  const size=window.innerWidth>=960?156:132;
  const animate=!ui.ringAnim;ui.ringAnim=true;
  $('dashHero').innerHTML=
   '<div class="hero"><div class="bismillah" lang="ar">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>'+
   (activeDisplayName()?'<p class="hero-greet">Assalamu\'alaikum, '+esc(activeDisplayName())+'</p>':'')+
   '<h1>Catatan Hafalan</h1><p class="date">'+esc(fmtFull(t))+'</p>'+
   '<div class="hero-main"><div class="ringbox">'+ring(pct,size,10,animate)+'<div class="ring-c"><b>'+nf.format(M.fullPages)+'</b><span>halaman penuh</span></div></div>'+
   '<div class="hero-t"><h2>Hafalan Quran</h2><p>'+nf.format(M.fullPages)+' dari '+TOTAL+' halaman</p><p>'+nf.format(M.ayat)+' dari '+nf.format(AYTOT)+' ayat</p><span class="pill">'+nf1.format(pct*100)+'%</span></div></div></div>';
  const st=streak();
  const mDone=S.matan.filter(m=>matanInfo(m).status.k==='selesai').length;
  $('dashStats').innerHTML=
   '<div class="stat"><b>'+M.juzDone+'<small>/30</small></b><span>Juz selesai</span></div>'+
   '<div class="stat"><b>'+st.n+'<small> hari</small></b><span>'+(st.today?'Rangkaian setoran':(st.n?'Lanjutkan hari ini':'Belum ada rangkaian'))+'</span></div>'+
   '<div class="stat"><b>'+mDone+'<small>/'+S.matan.length+'</small></b><span>Matan selesai</span></div>';
  // hari ini
  const tq={baru:0,murajaah:0},ta={baru:0,murajaah:0},tm={baru:0,murajaah:0};
  S.quran.forEach(e=>{if(e.date===t){tq[e.type]+=e.pages;ta[e.type]+=e.ayat;}});
  S.matanLog.forEach(e=>{if(e.date===t)tm[e.type]+=e.count;});
  const any=tq.baru+tq.murajaah+tm.baru+tm.murajaah>0;
  const cell=(v,u)=>'<div class="tv'+(v?'':' z')+'">'+(u==='hal'?fmtN(v):nf.format(v))+'<small>'+u+'</small></div>';
  $('dashToday').innerHTML=
   '<div class="ph"><h3>Hari ini</h3></div>'+
   (any?
     '<div class="tt"><div class="th"></div><div class="th">Hafalan baru</div><div class="th">Muraja\'ah</div>'+
     '<div class="tl">Quran</div>'+cell(tq.baru,'hal')+cell(tq.murajaah,'hal')+
     '<div class="tl">Quran</div>'+cell(ta.baru,'ayat')+cell(ta.murajaah,'ayat')+
     '<div class="tl">Matan</div>'+cell(tm.baru,'bait')+cell(tm.murajaah,'bait')+'</div>'
   :'<p class="lead">Belum ada setoran hari ini.</p>')+
   '<div class="row-actions"><button class="btn small primary" type="button" data-go="quran">Catat Quran</button><button class="btn small" type="button" data-go="matan">Catat matan</button></div>';
  // perkiraan
  const remaining=TOTAL-M.pageEq;
  let est;
  if(M.fullPages>=TOTAL)est='<p class="lead">Seluruh 30 juz sudah tercatat selesai. Alhamdulillah.</p>';
  else{
    const e=etaText(remaining,paceOf(S.quran.filter(x=>x.type==='baru'),x=>x.pages),'halaman');
    if(!e)est='';
    else if(!e.ok)est='<p class="lead">'+esc(e.text)+'</p>';
    else est='<p class="lead">Perkiraan selesai 30 juz: <b>'+esc(e.date)+'</b></p><p class="sub est">Sekitar '+esc(e.dur)+' lagi, dengan kecepatan rata-rata '+e.avg+' halaman per hari selama '+e.span+' hari terakhir.</p>';
  }
  $('dashEst').innerHTML='<div class="ph"><h3>Perkiraan khatam</h3></div>'+est;
  // matan
  if(!S.matan.length){
    $('dashMatan').innerHTML='<div class="ph"><h3>Hafalan matan</h3></div><p class="lead" style="margin-bottom:12px">Belum ada matan. Tambahkan nama dan jumlah baitnya untuk mulai mencatat.</p><button class="btn small primary" type="button" id="dashAddMatan">Tambah matan</button>';
  }else{
    $('dashMatan').innerHTML='<div class="ph"><h3>Hafalan matan</h3></div>'+S.matan.slice(0,5).map(m=>{
      const info=matanInfo(m),p=info.count/m.total*100;
      return'<button type="button" class="mrow" data-open-matan="'+esc(m.id)+'" style="width:100%;margin-bottom:8px"><span class="mr-t">'+esc(m.title)+'</span><span class="chip '+info.status.k+'">'+info.status.t+'</span><span class="mr-n">'+info.count+' dari '+m.total+' bait</span><span class="bar"><i style="width:'+p+'%"></i></span></button>';
    }).join('')+(S.matan.length>5?'<p class="sub">Dan '+(S.matan.length-5)+' matan lainnya di tab Matan.</p>':'');
  }
}

/* ---------- Quran ---------- */
const qEl={sj:$('q-sj'),sp:$('q-sp'),ej:$('q-ej'),ep:$('q-ep'),date:$('q-date'),res:$('q-result'),save:$('q-save')};
const aEl={ss:$('a-ss'),sa:$('a-sa'),es:$('a-es'),ea:$('a-ea')};
const qType=()=>document.querySelector('input[name="q-type"]:checked').value;
const qMode=()=>document.querySelector('input[name="q-mode"]:checked').value;
function dateError(){
  const d=qEl.date.value;
  if(!d)return'Pilih tanggal setoran.';
  if(d>todayS())return'Tanggal setoran tidak boleh di masa depan.';
  return null;
}
function overlapOf(a1,a2){
  if(qType()!=='baru')return 0;
  const M=mem();return M.mc[a2]-M.mc[a1-1];
}
function validatePage(){
  const sj=toInt(qEl.sj.value),sp=toInt(qEl.sp.value),ej=toInt(qEl.ej.value),ep=toInt(qEl.ep.value);
  const vals=[sj,sp,ej,ep];
  if(vals.every(v=>v===null))return{state:'empty',msg:'Isi juz dan halaman mulai serta selesai.'};
  if(vals.some(v=>v===null))return{state:'partial',msg:'Lengkapi juz dan halaman mulai serta selesai.'};
  if(vals.some(Number.isNaN))return{state:'error',msg:'Isi semua kolom dengan angka bulat, tanpa huruf atau tanda lain.'};
  if(sj<1||sj>30)return{state:'error',msg:'Juz mulai harus antara 1 dan 30.'};
  if(sp<1||sp>juzPages(sj))return{state:'error',msg:'Juz '+sj+' hanya punya '+juzPages(sj)+' halaman, jadi halaman mulai harus antara 1 dan '+juzPages(sj)+'.'};
  if(ej<1||ej>30)return{state:'error',msg:'Juz selesai harus antara 1 dan 30.'};
  if(ep<1||ep>juzPages(ej))return{state:'error',msg:'Juz '+ej+' hanya punya '+juzPages(ej)+' halaman, jadi halaman selesai harus antara 1 dan '+juzPages(ej)+'.'};
  const pa=gp(sj,sp),pb=gp(ej,ep);
  if(pb<pa)return{state:'error',msg:'Posisi selesai (Juz '+ej+' hal '+ep+') lebih awal dari posisi mulai (Juz '+sj+' hal '+sp+').'};
  const de=dateError();if(de)return{state:'error',msg:de};
  const a1=PS[pa],a2=PE[pb];
  return{state:'ok',mode:'page',pages:pb-pa+1,ayat:a2-a1+1,a1:a1,a2:a2,pa:pa,pb:pb,sj:sj,sp:sp,ej:ej,ep:ep,date:qEl.date.value,overlap:overlapOf(a1,a2)};
}
function validateAyat(){
  const ss=toInt(aEl.ss.value),sa=toInt(aEl.sa.value),es=toInt(aEl.es.value),ea=toInt(aEl.ea.value);
  const vals=[ss,sa,es,ea];
  if(vals.every(v=>v===null))return{state:'empty',msg:'Pilih surat, lalu isi ayat mulai dan selesai.'};
  if(vals.some(v=>v===null))return{state:'partial',msg:'Lengkapi surat dan ayat mulai serta selesai.'};
  if(vals.some(Number.isNaN))return{state:'error',msg:'Isi ayat dengan angka bulat, tanpa huruf atau tanda lain.'};
  if(ss<1||ss>114||es<1||es>114)return{state:'error',msg:'Pilih surat yang valid.'};
  if(sa<1||sa>AY[ss-1])return{state:'error',msg:SN[ss-1]+' hanya punya '+AY[ss-1]+' ayat, jadi ayat mulai harus antara 1 dan '+AY[ss-1]+'.'};
  if(ea<1||ea>AY[es-1])return{state:'error',msg:SN[es-1]+' hanya punya '+AY[es-1]+' ayat, jadi ayat selesai harus antara 1 dan '+AY[es-1]+'.'};
  const a1=gAyah(ss,sa),a2=gAyah(es,ea);
  if(a2<a1)return{state:'error',msg:'Posisi selesai ('+SN[es-1]+' '+ea+') lebih awal dari posisi mulai ('+SN[ss-1]+' '+sa+').'};
  const de=dateError();if(de)return{state:'error',msg:de};
  return{state:'ok',mode:'ayat',pages:pageEq(a1,a2),ayat:a2-a1+1,a1:a1,a2:a2,ss:ss,sa:sa,es:es,ea:ea,date:qEl.date.value,overlap:overlapOf(a1,a2)};
}
const validateQuran=()=>qMode()==='ayat'?validateAyat():validatePage();
function updateQ(){
  const v=validateQuran();
  qEl.res.className='res'+(v.state==='ok'?' ok':v.state==='error'?' err':'');
  if(v.state==='ok'){
    let h;
    if(v.mode==='page')h='<div><span class="big">'+v.pages+'</span>halaman</div><div class="sub2">'+esc(pageRangeJuz(v.pa,v.pb))+'</div><div class="sub2">Setara <b>'+nf.format(v.ayat)+' ayat</b>: '+esc(gRangeText(v.a1,v.a2))+'</div>';
    else h='<div><span class="big">'+nf.format(v.ayat)+'</span>ayat</div><div class="sub2">'+esc(ayatRangeText(v.ss,v.sa,v.es,v.ea))+'</div><div class="sub2">Sekitar <b>'+fmtN(v.pages)+' halaman</b>, di '+esc(pageRangeJuz(pageOfAyah(v.a1),pageOfAyah(v.a2)))+'</div>';
    if(v.overlap)h+='<div class="note">'+v.overlap+' ayat sudah tercatat sebagai hafalan baru sebelumnya.</div>';
    qEl.res.innerHTML=h;
  }else qEl.res.textContent=v.msg;
  qEl.save.disabled=v.state!=='ok';
}
function setMapMode(k){
  ui.mapMode=k;
  const r=document.querySelector('input[name="map-mode"][value="'+k+'"]');if(r)r.checked=true;
  $('mapJuz').hidden=k!=='juz';$('mapSurat').hidden=k!=='surat';
}
function setQMode(m){
  const r=document.querySelector('input[name="q-mode"][value="'+m+'"]');if(r)r.checked=true;
  $('qm-page').hidden=m!=='page';$('qm-ayat').hidden=m!=='ayat';
  setMapMode(m==='page'?'juz':'surat');
  updateQ();
}
function prefillQuran(){
  let best=null;
  S.quran.forEach(e=>{if(e.type==='baru'&&(!best||e.date>best.date||(e.date===best.date&&e.ts>=best.ts)))best=e;});
  qEl.ej.value='';qEl.ep.value='';aEl.es.value='';aEl.ea.value='';
  qEl.sj.value='';qEl.sp.value='';aEl.ss.value='';aEl.sa.value='';
  if(best){
    const pe=pageOfAyah(best.a2),np=best.a2===PE[pe]?pe+1:pe;
    if(np<=604){const q=fromGp(np);qEl.sj.value=q.j;qEl.sp.value=q.p;}
    const g=best.a2+1;
    if(g<=AYTOT){const x=ayahFromG(g);aEl.ss.value=String(x.s);aEl.sa.value=x.a;}
  }
  updateQ();
}
async function saveQuran(){
  const v=validateQuran();
  if(v.state!=='ok')return;
  let type=qType();
  if(type==='baru'&&v.overlap>0){
    const c=await ask({title:'Sebagian sudah tercatat',body:v.overlap+' dari '+v.ayat+' ayat di rentang ini sudah tercatat sebagai hafalan baru. Simpan sebagai apa?',
      actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Tetap hafalan baru',value:'baru'},{label:"Muraja'ah",value:'murajaah',kind:'primary'}]});
    if(!c)return;
    type=c;
  }
  const base={id:uid(),date:v.date,type:type,ts:Date.now()};
  const e=v.mode==='ayat'
    ?deriveQ(Object.assign(base,{mode:'ayat',ss:v.ss,sa:v.sa,es:v.es,ea:v.ea}))
    :deriveQ(Object.assign(base,{sj:v.sj,sp:v.sp,ej:v.ej,ep:v.ep}));
  S.quran.push(e);memVer++;
  ui.sel=null;ui.selA=null;ui.juzE=null;ui.selE=null;ui.crossRange=null;ui.surahE=null;ui.selAE=null;ui.crossRangeA=null;
  markDirty(qDoc(e));
  if(type==='baru')prefillQuran();
  else{qEl.ej.value='';qEl.ep.value='';aEl.es.value='';aEl.ea.value='';updateQ();}
  renderAll();
  toast('Setoran tersimpan: '+(v.mode==='ayat'?nf.format(v.ayat)+' ayat':v.pages+' halaman'));
}
function renderJuz(){
  const M=mem();
  let html='';
  for(let j=1;j<=30;j++){
    const J=M.juz[j],cls=J.done?'done':(J.eq>0?'part':'empty');
    html+='<button type="button" class="jt '+cls+(ui.juz===j?' sel':'')+'" data-j="'+j+'" aria-label="Juz '+j+', '+J.full+' dari '+J.n+' halaman'+(J.eq>J.full+0.001?', sebagian lainnya sudah dihafal':'')+'"'+(ui.juz===j?' aria-pressed="true"':'')+'><span class="fill" style="height:'+(J.eq/J.n*100)+'%"></span><span class="n">'+j+'</span></button>';
  }
  $('jmap').innerHTML=html;
  $('q-sum').textContent=nf.format(M.fullPages)+' dari '+TOTAL+' halaman penuh, '+nf.format(M.ayat)+' dari '+nf.format(AYTOT)+' ayat, '+M.juzDone+' juz selesai';
  const box=$('juzDetail');
  if(!ui.juz){box.innerHTML='<p class="sub" style="margin-top:14px">Ketuk sebuah juz untuk melihat halaman yang sudah dihafal.</p>';$('mapJuzEnd').hidden=true;return;}
  const j=ui.juz,J=M.juz[j],n=J.n;
  const sel=ui.sel&&ui.sel.j===j?ui.sel:null;
  const cr=ui.crossRange&&ui.crossRange.sj===j?ui.crossRange:null;
  let pages='';
  for(let p=1;p<=n;p++){
    const g=gp(j,p),full=M.full[g],fr=M.frac[g],part=!full&&fr>0;
    const picked=sel&&p>=sel.a&&p<=sel.b,edge=sel&&(p===sel.a||p===sel.b);
    pages+='<button type="button" class="pg'+(full?' on':'')+(part?' half':'')+(picked?' pick':'')+(edge?' edge':'')+'" data-p="'+p+'"'+(part?' style="--f:'+fr.toFixed(3)+'"':'')+' aria-pressed="'+(picked?'true':'false')+'" aria-label="Halaman '+p+', '+(full?'sudah hafal':(part?'sebagian sudah dihafal':'belum dihafal'))+'">'+p+'</button>';
  }
  const partN=Math.round(J.eq-J.full)>0||(J.eq-J.full>0.001);
  let info;
  if(cr)info='Terpilih: <b>Juz '+cr.sj+' hal '+cr.sp+'</b> sampai <b>Juz '+cr.ej+' hal '+cr.ep+'</b>. Lihat pilihan akhir di bawah.';
  else if(!sel)info='Ketuk halaman awal, lalu halaman akhir, untuk mengisi formulir setoran.';
  else if(sel.picking)info='<b>Halaman '+sel.a+'</b> dipilih. Ketuk halaman lain di juz ini untuk membuat rentang, ketuk lagi untuk membatalkan, atau pilih juz lain di bawah kalau rentangnya sampai juz berikutnya.';
  else info='Terpilih: <b>hal '+sel.a+' sampai '+sel.b+'</b> ('+(sel.b-sel.a+1)+' halaman).';
  const showActions=sel&&(!sel.picking||cr);
  box.innerHTML='<div class="jd"><div class="jd-h"><h4>Juz '+j+'</h4><span class="sub">'+J.full+' dari '+n+' halaman sudah tercatat sebelumnya'+(partN?' (ada yang sebagian)':'')+'</span></div><div class="pages">'+pages+'</div>'+
    '<p class="pick-info" aria-live="polite">'+info+'</p>'+
    '<div class="row-actions">'+(showActions?'<button class="btn small primary" type="button" data-go-form="1">Lanjut ke formulir</button><button class="btn small" type="button" data-clear-sel="1">Batalkan pilihan</button>':(sel?'':'<button class="btn small" type="button" data-start-juz="'+j+'">Mulai setoran dari sini</button>'))+'</div></div>';
  const showEnd=(sel&&sel.picking)||cr;
  $('mapJuzEnd').hidden=!showEnd;
  if(showEnd)renderJuzEnd();
}
function renderJuzEnd(){
  const M=mem();
  let html='';
  for(let j=1;j<=30;j++){
    const J=M.juz[j],cls=J.done?'done':(J.eq>0?'part':'empty');
    html+='<button type="button" class="jt '+cls+(ui.juzE===j?' sel':'')+'" data-j="'+j+'" aria-label="Juz '+j+' (akhir), '+J.full+' dari '+J.n+' halaman'+(J.eq>J.full+0.001?', sebagian lainnya sudah dihafal':'')+'"'+(ui.juzE===j?' aria-pressed="true"':'')+'><span class="fill" style="height:'+(J.eq/J.n*100)+'%"></span><span class="n">'+j+'</span></button>';
  }
  $('jmapEnd').innerHTML=html;
  const box=$('juzDetailEnd');
  if(!ui.juzE){box.innerHTML='<p class="sub" style="margin-top:14px">Ketuk sebuah juz untuk halaman akhir rentang.</p>';return;}
  const j=ui.juzE,J=M.juz[j],n=J.n;
  const sel=ui.selE&&ui.selE.j===j?ui.selE:null;
  let pages='';
  for(let p=1;p<=n;p++){
    const g=gp(j,p),full=M.full[g],fr=M.frac[g],part=!full&&fr>0;
    const picked=sel&&p===sel.a;
    pages+='<button type="button" class="pg'+(full?' on':'')+(part?' half':'')+(picked?' pick edge':'')+'" data-p="'+p+'"'+(part?' style="--f:'+fr.toFixed(3)+'"':'')+' aria-pressed="'+(picked?'true':'false')+'" aria-label="Halaman '+p+', '+(full?'sudah hafal':(part?'sebagian sudah dihafal':'belum dihafal'))+'">'+p+'</button>';
  }
  const partN=Math.round(J.eq-J.full)>0||(J.eq-J.full>0.001);
  const info=sel?'<b>Halaman '+sel.a+'</b> dipilih sebagai akhir rentang. Ketuk lagi untuk membatalkan.':'Ketuk halaman akhir rentang.';
  box.innerHTML='<div class="jd"><div class="jd-h"><h4>Juz '+j+' (akhir)</h4><span class="sub">'+J.full+' dari '+n+' halaman sudah tercatat sebelumnya'+(partN?' (ada yang sebagian)':'')+'</span></div><div class="pages">'+pages+'</div>'+
    '<p class="pick-info" aria-live="polite">'+info+'</p></div>';
}
function renderSurat(){
  const M=mem();
  let html='';
  for(let s=1;s<=114;s++){
    const n=AY[s-1],c=M.sur[s],cls=c===n?'done':(c===0?'empty':'part');
    html+='<button type="button" class="jt st '+cls+(ui.surah===s?' sel':'')+'" data-s="'+s+'" aria-label="'+esc(SN[s-1])+', '+c+' dari '+n+' ayat"'+(ui.surah===s?' aria-pressed="true"':'')+'><span class="fill" style="height:'+(c/n*100)+'%"></span><span class="n">'+s+'</span></button>';
  }
  $('smap').innerHTML=html;
  $('surSel').value=ui.surah?String(ui.surah):'';
  const box=$('suratDetail');
  if(!ui.surah){box.innerHTML='<p class="sub" style="margin-top:14px">Pilih surat dari daftar atau ketuk kotaknya untuk melihat ayat yang sudah dihafal.</p>';$('mapSuratEnd').hidden=true;return;}
  const s=ui.surah,n=AY[s-1],c=M.sur[s];
  const sel=ui.selA&&ui.selA.s===s?ui.selA:null;
  const cr=ui.crossRangeA&&ui.crossRangeA.ss===s?ui.crossRangeA:null;
  let cells='';
  for(let a=1;a<=n;a++){
    const on=M.flag[gAyah(s,a)],picked=sel&&a>=sel.a&&a<=sel.b,edge=sel&&(a===sel.a||a===sel.b);
    cells+='<button type="button" class="bt'+(on?' h':'')+(picked?' pick':'')+(edge?' edge':'')+'" data-a="'+a+'" aria-pressed="'+(picked?'true':'false')+'" aria-label="Ayat '+a+', '+(on?'sudah hafal':'belum dihafal')+'">'+a+'</button>';
  }
  let info;
  if(cr)info='Terpilih: <b>'+esc(SN[cr.ss-1])+' ayat '+cr.sa+'</b> sampai <b>'+esc(SN[cr.es-1])+' ayat '+cr.ea+'</b>. Lihat pilihan akhir di bawah.';
  else if(!sel)info='Ketuk ayat awal, lalu ayat akhir, untuk mengisi formulir setoran.';
  else if(sel.picking)info='<b>Ayat '+sel.a+'</b> dipilih. Ketuk ayat lain untuk membuat rentang, ketuk lagi untuk membatalkan, atau pilih surat lain di bawah kalau rentangnya sampai surat berikutnya.';
  else info='Terpilih: <b>ayat '+sel.a+' sampai '+sel.b+'</b> ('+(sel.b-sel.a+1)+' ayat).';
  const showActions=sel&&(!sel.picking||cr);
  box.innerHTML='<div class="jd"><div class="jd-h"><h4>'+s+'. '+esc(SN[s-1])+'</h4><span class="sub">'+c+' dari '+n+' ayat sudah tercatat sebelumnya</span></div>'+
    '<div class="bmap ayb" style="--bt:52px;--bf:17px">'+cells+'</div>'+
    '<p class="pick-info" aria-live="polite">'+info+'</p>'+
    '<div class="row-actions">'+(showActions?'<button class="btn small primary" type="button" data-go-form="1">Lanjut ke formulir</button><button class="btn small" type="button" data-clear-sel="1">Batalkan pilihan</button>':(sel?'':'<button class="btn small" type="button" data-start-sur="'+s+'">Mulai setoran dari sini</button>'))+'</div></div>';
  const showEnd=(sel&&sel.picking)||cr;
  $('mapSuratEnd').hidden=!showEnd;
  if(showEnd)renderSuratEnd();
}
function renderSuratEnd(){
  const M=mem();
  let html='';
  for(let s=1;s<=114;s++){
    const n=AY[s-1],c=M.sur[s],cls=c===n?'done':(c===0?'empty':'part');
    html+='<button type="button" class="jt st '+cls+(ui.surahE===s?' sel':'')+'" data-s="'+s+'" aria-label="'+esc(SN[s-1])+' (akhir), '+c+' dari '+n+' ayat"'+(ui.surahE===s?' aria-pressed="true"':'')+'><span class="fill" style="height:'+(c/n*100)+'%"></span><span class="n">'+s+'</span></button>';
  }
  $('smapEnd').innerHTML=html;
  $('surSelEnd').value=ui.surahE?String(ui.surahE):'';
  const box=$('suratDetailEnd');
  if(!ui.surahE){box.innerHTML='<p class="sub" style="margin-top:14px">Pilih surat untuk ayat akhir rentang.</p>';return;}
  const s=ui.surahE,n=AY[s-1],c=M.sur[s];
  const sel=ui.selAE&&ui.selAE.s===s?ui.selAE:null;
  let cells='';
  for(let a=1;a<=n;a++){
    const on=M.flag[gAyah(s,a)],picked=sel&&a===sel.a;
    cells+='<button type="button" class="bt'+(on?' h':'')+(picked?' pick edge':'')+'" data-a="'+a+'" aria-pressed="'+(picked?'true':'false')+'" aria-label="Ayat '+a+', '+(on?'sudah hafal':'belum dihafal')+'">'+a+'</button>';
  }
  const info=sel?'<b>Ayat '+sel.a+'</b> dipilih sebagai akhir rentang. Ketuk lagi untuk membatalkan.':'Ketuk ayat akhir rentang.';
  box.innerHTML='<div class="jd"><div class="jd-h"><h4>'+s+'. '+esc(SN[s-1])+' (akhir)</h4><span class="sub">'+c+' dari '+n+' ayat sudah tercatat sebelumnya</span></div>'+
    '<div class="bmap ayb" style="--bt:52px;--bf:17px">'+cells+'</div>'+
    '<p class="pick-info" aria-live="polite">'+info+'</p></div>';
}
function qRangeText(e){
  if(e.mode==='ayat')return ayatRangeText(e.ss,e.sa,e.es,e.ea);
  return e.sj===e.ej?'Juz '+e.sj+', hal '+e.sp+'–'+e.ep:'Juz '+e.sj+' hal '+e.sp+' sampai Juz '+e.ej+' hal '+e.ep;
}
function qSubText(e){
  if(e.mode==='ayat')return'Sekitar '+fmtN(e.pages)+' halaman, di '+pageRangeJuz(pageOfAyah(e.a1),pageOfAyah(e.a2));
  return nf.format(e.ayat)+' ayat: '+gRangeText(e.a1,e.a2);
}
function sortDesc(a,b){return a.date<b.date?1:a.date>b.date?-1:(b.ts-a.ts);}
function renderQHist(){
  const list=S.quran.slice().sort(sortDesc);
  let html='<div class="ph"><h3>Riwayat setoran</h3></div>';
  if(!list.length){$('qHist').innerHTML=html+'<p class="sub">Belum ada setoran. Isi formulir di atas untuk mencatat yang pertama.</p>';return;}
  html+=list.slice(0,ui.qShown).map(e=>
    '<div class="hrow"><div><div class="h-d">'+esc(fmtDay(e.date))+' '+e.date.slice(0,4)+' <span class="chip '+(e.type==='baru'?'baru':'mur')+'">'+(e.type==='baru'?'Baru':"Muraja'ah")+'</span></div><div class="h-r">'+esc(qRangeText(e))+'</div><div class="h-r h-r2">'+esc(qSubText(e))+'</div></div>'+
    '<div class="h-n">'+(e.mode==='ayat'?'<b>'+nf.format(e.ayat)+'</b>ayat<div class="h-n2">sekitar '+fmtN(e.pages)+' hal</div>':'<b>'+e.pages+'</b>hal<div class="h-n2">'+nf.format(e.ayat)+' ayat</div>')+'</div>'+
    '<button class="icon-btn" type="button" data-del-q="'+esc(e.id)+'" aria-label="Hapus setoran">'+ICON.trash+'</button></div>').join('');
  if(list.length>ui.qShown)html+='<button class="btn small more" type="button" id="qMore">Tampilkan lebih banyak</button>';
  $('qHist').innerHTML=html;
}
async function delQuran(id){
  const e=S.quran.find(x=>x.id===id);if(!e)return;
  const c=await ask({title:'Hapus setoran ini?',body:fmtLong(e.date)+', '+qRangeText(e)+' ('+(e.mode==='ayat'?nf.format(e.ayat)+' ayat':e.pages+' halaman')+'). Setoran yang dihapus tidak bisa dikembalikan.',
    actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Hapus',value:'del',kind:'danger'}]});
  if(c!=='del')return;
  const idx=S.quran.indexOf(e);
  S.quran=S.quran.filter(x=>x.id!==id);memVer++;
  updateQ();renderAll();
  scheduleUndoableRemoval('q-'+id,'Setoran dihapus',
    ()=>{markDirty(qDoc(e));},
    ()=>{S.quran.splice(idx,0,e);memVer++;updateQ();renderAll();markDirty(qDoc(e));});
}

/* ---------- Matan ---------- */
const mEl={from:$('m-from'),to:$('m-to'),date:$('m-date'),res:$('m-result'),save:$('m-save')};
const mType=()=>document.querySelector('input[name="m-type"]:checked').value;
function validateMatan(){
  const m=curMatan();
  if(!m)return{state:'empty',msg:'Pilih matan terlebih dahulu.'};
  const f=toInt(mEl.from.value),t=toInt(mEl.to.value);
  if(f===null&&t===null)return{state:'empty',msg:'Isi bait mulai dan bait selesai.'};
  if(f===null||t===null)return{state:'partial',msg:'Lengkapi bait mulai dan bait selesai.'};
  if(Number.isNaN(f)||Number.isNaN(t))return{state:'error',msg:'Isi dengan angka bulat, tanpa huruf atau tanda lain.'};
  if(f<1||f>m.total)return{state:'error',msg:'Bait mulai harus antara 1 dan '+m.total+' (jumlah bait matan ini).'};
  if(t<1||t>m.total)return{state:'error',msg:'Bait selesai harus antara 1 dan '+m.total+' (jumlah bait matan ini).'};
  if(t<f)return{state:'error',msg:'Bait selesai ('+t+') lebih kecil dari bait mulai ('+f+').'};
  const d=mEl.date.value;
  if(!d)return{state:'error',msg:'Pilih tanggal setoran.'};
  if(d>todayS())return{state:'error',msg:'Tanggal setoran tidak boleh di masa depan.'};
  let overlap=0;
  if(mType()==='baru'){const info=matanInfo(m);for(let b=f;b<=t;b++)if(info.mem.has(b))overlap++;}
  return{state:'ok',count:t-f+1,from:f,to:t,date:d,overlap:overlap,m:m};
}
function updateM(){
  const v=validateMatan();
  mEl.res.className='res'+(v.state==='ok'?' ok':v.state==='error'?' err':'');
  if(v.state==='ok'){
    mEl.res.innerHTML='<div><span class="big">'+v.count+'</span>bait</div><div class="sub2">Bait '+v.from+' sampai '+v.to+'</div>'+
      (v.overlap?'<div class="note">'+v.overlap+' bait sudah tercatat sebagai hafalan baru sebelumnya.</div>':'');
  }else mEl.res.textContent=v.msg;
  mEl.save.disabled=v.state!=='ok';
}
function prefillMatan(){
  const m=curMatan();mEl.to.value='';mEl.from.value='';
  if(m){const info=matanInfo(m);if(info.maxBaru>0&&info.maxBaru<m.total)mEl.from.value=info.maxBaru+1;}
  updateM();
}
function selectMatan(id){
  ui.matanId=id;ui.bait=null;ui.selM=null;ui.mShown=15;
  prefillMatan();renderMatan();
}
async function saveMatanEntry(){
  const v=validateMatan();
  if(v.state!=='ok')return;
  let type=mType();
  if(type==='baru'&&v.overlap>0){
    const c=await ask({title:'Sebagian sudah tercatat',body:v.overlap+' dari '+v.count+' bait di rentang ini sudah tercatat sebagai hafalan baru. Simpan sebagai apa?',
      actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Tetap hafalan baru',value:'baru'},{label:"Muraja'ah",value:'murajaah',kind:'primary'}]});
    if(!c)return;
    type=c;
  }
  const e={id:uid(),matanId:v.m.id,date:v.date,type:type,from:v.from,to:v.to,count:v.count,ts:Date.now()};
  S.matanLog.push(e);
  markDirty(lDoc(e));
  ui.selM=null;
  if(type==='baru')prefillMatan();else{mEl.to.value='';updateM();}
  renderAll();
  toast('Setoran tersimpan: '+v.count+' bait');
}
function renderMatan(){
  const list=$('mList');
  $('m-sum').textContent=S.matan.length?S.matan.length+' matan tercatat':'';
  if(!S.matan.length){
    list.innerHTML='<div class="panel empty" style="grid-column:1/-1"><h3>Belum ada matan</h3><p>Tambahkan nama matan dan jumlah baitnya. Setelah itu kamu bisa mencatat bait yang dihafal setiap hari.</p><button class="btn primary" type="button" data-add-matan="1">Tambah matan pertama</button></div>';
    $('mWork').hidden=true;ui.matanId=null;return;
  }
  if(!curMatan()){ui.matanId=S.matan[0].id;prefillMatan();}
  list.innerHTML=S.matan.map(m=>{
    const info=matanInfo(m),p=info.count/m.total*100;
    return'<button type="button" class="mrow'+(m.id===ui.matanId?' sel':'')+'" data-m="'+esc(m.id)+'" aria-pressed="'+(m.id===ui.matanId)+'"><span class="mr-t">'+esc(m.title)+'</span><span class="chip '+info.status.k+'">'+info.status.t+'</span><span class="mr-n">'+info.count+' dari '+m.total+' bait</span><span class="bar"><i style="width:'+p+'%"></i></span></button>';
  }).join('');
  $('mWork').hidden=false;
  const m=curMatan(),info=matanInfo(m),t=todayS();
  const pct=info.count/m.total*100;
  const bt=52;
  let tiles='';
  for(let b=1;b<=m.total;b++){
    const s=info.state(b);
    const picked=ui.selM&&b>=ui.selM.a&&b<=ui.selM.b,edge=ui.selM&&(b===ui.selM.a||b===ui.selM.b);
    tiles+='<div class="bt'+(s==='hafal'?' h':s==='ulang'?' u':'')+(picked?' pick':'')+(edge?' edge':'')+'" data-b="'+b+'">'+b+'</div>';
  }
  let est='';
  const rem=m.total-info.count;
  if(rem<=0)est='<p class="lead">Seluruh bait matan ini sudah tercatat hafal. Alhamdulillah.</p>';
  else{
    const e=etaText(rem,paceOf(S.matanLog.filter(x=>x.matanId===m.id&&x.type==='baru'),x=>x.count),'bait');
    if(e&&e.ok)est='<p class="lead">Perkiraan selesai: <b style="font:600 22px var(--serif)">'+esc(e.date)+'</b></p><p class="sub">Sekitar '+esc(e.dur)+' lagi, rata-rata '+e.avg+' bait per hari selama '+e.span+' hari terakhir.</p>';
    else if(e)est='<p class="sub">'+esc(e.text)+'</p>';
  }
  let baitInfo;
  if(ui.selM&&ui.selM.picking){
    const st=info.state(ui.selM.a),lbl=st==='belum'?'belum dihafal':st==='hafal'?'hafal':'perlu diulang';
    baitInfo='<b>Bait '+ui.selM.a+'</b> dipilih ('+lbl+'). Ketuk bait lain untuk membuat rentang, atau ketuk lagi untuk membatalkan.';
  }else if(ui.selM){
    baitInfo='Terpilih: <b>bait '+ui.selM.a+' sampai '+ui.selM.b+'</b> ('+(ui.selM.b-ui.selM.a+1)+' bait).';
  }else{
    baitInfo=(info.stale?info.stale+' bait perlu diulang. ':'')+'Ketuk sebuah kotak untuk memilih bait, lalu ketuk lagi untuk rentangnya.';
  }
  $('mDetail').innerHTML=
   '<div class="ph"><div><h3>'+esc(m.title)+'</h3><p class="sub">'+info.count+' dari '+m.total+' bait ('+nf1.format(pct)+'%) <span class="chip '+info.status.k+'">'+info.status.t+'</span></p></div>'+
   '<div class="acts"><button class="icon-btn" type="button" data-act="edit" aria-label="Ubah matan">'+ICON.edit+'</button><button class="icon-btn" type="button" data-act="del" aria-label="Hapus matan">'+ICON.trash+'</button></div></div>'+
   '<div class="bar big"><i style="width:'+pct+'%"></i></div>'+
   '<div class="bmap" id="bmap" style="--bt:'+bt+'px" role="img" aria-label="Peta bait: '+(info.count-info.stale)+' hafal, '+info.stale+' perlu diulang, '+(m.total-info.count)+' belum dihafal">'+tiles+'</div>'+
   '<div class="legend"><span><i></i>Belum</span><span><i class="h"></i>Hafal</span><span><i class="u"></i>Perlu diulang (lebih dari '+STALE+' hari tanpa disetor)</span></div>'+
   '<p class="sub" id="baitInfo" aria-live="polite">'+baitInfo+'</p>'+est;
  // riwayat
  const logs=S.matanLog.filter(e=>e.matanId===m.id).sort(sortDesc);
  let h='<div class="ph"><h3>Riwayat setoran</h3></div>';
  if(!logs.length)h+='<p class="sub">Belum ada setoran untuk matan ini.</p>';
  else{
    h+=logs.slice(0,ui.mShown).map(e=>
      '<div class="hrow"><div><div class="h-d">'+esc(fmtDay(e.date))+' '+e.date.slice(0,4)+' <span class="chip '+(e.type==='baru'?'baru':'mur')+'">'+(e.type==='baru'?'Baru':"Muraja'ah")+'</span></div><div class="h-r">Bait '+e.from+' sampai '+e.to+'</div></div>'+
      '<div class="h-n"><b>'+e.count+'</b>bait</div><button class="icon-btn" type="button" data-del-m="'+esc(e.id)+'" aria-label="Hapus setoran">'+ICON.trash+'</button></div>').join('');
    if(logs.length>ui.mShown)h+='<button class="btn small more" type="button" id="mMore">Tampilkan lebih banyak</button>';
  }
  $('mHist').innerHTML=h;
}
async function delMatanEntry(id){
  const e=S.matanLog.find(x=>x.id===id);if(!e)return;
  const c=await ask({title:'Hapus setoran ini?',body:fmtLong(e.date)+', bait '+e.from+' sampai '+e.to+' ('+e.count+' bait). Setoran yang dihapus tidak bisa dikembalikan.',
    actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Hapus',value:'del',kind:'danger'}]});
  if(c!=='del')return;
  const idx=S.matanLog.indexOf(e);
  S.matanLog=S.matanLog.filter(x=>x.id!==id);
  updateM();renderAll();
  scheduleUndoableRemoval('ml-'+id,'Setoran dihapus',
    ()=>{markDirty(lDoc(e));},
    ()=>{S.matanLog.splice(idx,0,e);updateM();renderAll();markDirty(lDoc(e));});
}
async function delMatan(){
  const m=curMatan();if(!m)return;
  const n=S.matanLog.filter(e=>e.matanId===m.id).length;
  const c=await ask({title:'Hapus matan "'+m.title+'"?',body:n?'Semua '+n+' catatan setoran matan ini juga akan terhapus dan tidak bisa dikembalikan.':'Matan ini belum punya catatan setoran.',
    actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Hapus matan',value:'del',kind:'danger'}]});
  if(c!=='del')return;
  const midx=S.matan.indexOf(m);
  const removedLogs=S.matanLog.filter(e=>e.matanId===m.id);
  const years=new Set(removedLogs.map(lDoc));
  S.matan=S.matan.filter(x=>x.id!==m.id);
  S.matanLog=S.matanLog.filter(e=>e.matanId!==m.id);
  ui.matanId=null;
  renderAll();
  scheduleUndoableRemoval('matan-'+m.id,'Matan dihapus',
    ()=>{markDirty.apply(null,['matan'].concat(Array.from(years)));},
    ()=>{S.matan.splice(midx,0,m);S.matanLog=S.matanLog.concat(removedLogs);ui.matanId=m.id;renderAll();markDirty.apply(null,['matan'].concat(Array.from(years)));});
}
/* Dialog tambah / ubah matan */
let mdMode='add';
function openMatanDlg(mode){
  mdMode=mode;
  const m=mode==='edit'?curMatan():null;
  $('mdTitle').textContent=m?'Ubah matan':'Tambah matan';
  $('md-title').value=m?m.title:'';
  $('md-total').value=m?m.total:'';
  $('md-msg').textContent='';
  openNonModal(mdlg);
  setTimeout(()=>$('md-title').focus(),30);
}
function submitMatanDlg(ev){
  ev.preventDefault();
  const title=$('md-title').value.trim(),total=toInt($('md-total').value);
  const msg=t=>{$('md-msg').textContent=t;};
  if(!title)return msg('Isi nama matan.');
  if(total===null)return msg('Isi jumlah bait.');
  if(Number.isNaN(total)||total<1)return msg('Jumlah bait harus berupa angka bulat lebih dari 0.');
  if(total>20000)return msg('Jumlah bait terlalu besar. Maksimal 20.000.');
  if(mdMode==='edit'){
    const m=curMatan();
    const info=matanInfo(m);
    if(total<info.maxBait)return msg('Jumlah bait tidak boleh lebih kecil dari '+info.maxBait+', bait tertinggi yang sudah tercatat. Hapus dulu setoran yang melewati batas itu.');
    m.title=title.slice(0,80);m.total=total;
    markDirty('matan');
    mdlg.close();renderAll();toast('Matan diperbarui');
  }else{
    const m={id:uid(),title:title.slice(0,80),total:total,createdAt:Date.now()};
    S.matan.push(m);
    markDirty('matan');
    mdlg.close();
    ui.matanId=m.id;prefillMatan();renderAll();
    if(ui.view!=='matan')showView('matan');
    toast('Matan ditambahkan');
  }
}

/* ---------- Rekap ---------- */
function mondayOf(s){const d=parseD(s);d.setDate(d.getDate()-((d.getDay()+6)%7));return ymd(d);}
function keyFor(dateStr,mode){
  if(mode==='day')return dateStr;
  if(mode==='week')return mondayOf(dateStr);
  if(mode==='month')return dateStr.slice(0,7);
  return dateStr.slice(0,4);
}
function weekLabel(k){
  const a=parseD(k),b=parseD(addDays(k,6));
  return a.getMonth()===b.getMonth()&&a.getFullYear()===b.getFullYear()
    ?a.getDate()+'–'+b.getDate()+' '+MON3[b.getMonth()]+' '+b.getFullYear()
    :a.getDate()+' '+MON3[a.getMonth()]+(a.getFullYear()!==b.getFullYear()?' '+a.getFullYear():'')+' – '+b.getDate()+' '+MON3[b.getMonth()]+' '+b.getFullYear();
}
function periods(mode){
  const t=todayS(),out=[],curKey=keyFor(t,mode),Y=ui.ryear,M=ui.rmonth;
  if(mode==='day'){
    const n=new Date(Y,M+1,0).getDate();
    for(let d=1;d<=n;d++){
      const k=Y+'-'+pad(M+1)+'-'+pad(d);
      out.push({key:k,short:(d===1||d%5===0)?String(d):'',label:fmtDay(k)+' '+Y});
    }
  }else if(mode==='week'){
    let k=mondayOf(Y+'-01-01'),prev=-1;
    const end=Y+'-12-31';
    while(k<=end){
      const mo=parseD(addDays(k,3)).getMonth();
      out.push({key:k,short:mo!==prev?MON3[mo]:'',label:weekLabel(k)});
      prev=mo;k=addDays(k,7);
    }
  }else if(mode==='month'){
    for(let m=0;m<12;m++)out.push({key:Y+'-'+pad(m+1),short:MON3[m],label:MONTHS[m]+' '+Y});
  }else{
    let first=new Date().getFullYear();
    S.quran.concat(S.matanLog).forEach(e=>{const y=Number(e.date.slice(0,4));if(y<first)first=y;});
    const cy=new Date().getFullYear(),n=Math.min(8,Math.max(3,cy-first+1));
    for(let y=cy-n+1;y<=cy;y++)out.push({key:String(y),short:String(y),label:String(y)});
  }
  out.forEach(p=>{p.cur=p.key===curKey;p.future=p.key>curKey;p.baru=0;p.mur=0;});
  return out;
}
const metricSrc=m=>m==='matan'?S.matanLog:S.quran;
const metricVal=(m,e)=>m==='quran'?e.pages:(m==='ayat'?e.ayat:e.count);
const metricName=m=>({quran:'hafalan Quran dalam halaman',ayat:'hafalan Quran dalam ayat',matan:'hafalan matan dalam bait'})[m];
function aggregate(mode,metric){
  const rows=periods(mode),map=new Map();
  rows.forEach(r=>map.set(r.key,r));
  const src=metricSrc(metric);
  src.forEach(e=>{
    const r=map.get(keyFor(e.date,mode));
    if(!r)return;
    const v=metricVal(metric,e);
    if(e.type==='baru')r.baru+=v;else r.mur+=v;
  });
  return rows;
}
function niceMax(v){
  const c=[2,4,6,8,10,12,16,20,30,40,60,80,100,120,160,200,300,400,600,800,1000,1200,1600,2000,3000,4000,6000,8000,10000];
  for(const x of c)if(v<=x)return x;
  return Math.ceil(v/2000)*2000;
}
function chartSVG(rows,W,label){
  const H=220,L=34,R=6,T=18,B=28,pw=W-L-R,ph=H-T-B,n=rows.length;
  const nm=niceMax(Math.max(1,...rows.map(r=>r.baru+r.mur)));
  const slot=pw/n,bw=Math.min(30,slot*0.62);
  let s='<svg viewBox="0 0 '+W+' '+H+'" width="'+W+'" height="'+H+'" role="img" aria-label="'+esc(label)+'">';
  [0,.5,1].forEach(f=>{
    const y=T+ph*(1-f);
    s+='<line class="gl" x1="'+L+'" x2="'+(W-R)+'" y1="'+y+'" y2="'+y+'"/><text class="ax" x="'+(L-6)+'" y="'+(y+3.5)+'" text-anchor="end">'+nf.format(nm*f)+'</text>';
  });
  rows.forEach((r,i)=>{
    const cx=L+slot*i+slot/2,x=cx-bw/2;
    let y=T+ph;
    if(r.baru>0){const h=Math.max(2,r.baru/nm*ph);y-=h;s+='<rect class="b1" x="'+x+'" y="'+y+'" width="'+bw+'" height="'+h+'" rx="2"/>';}
    if(r.mur>0){const h=Math.max(2,r.mur/nm*ph);y-=h;s+='<rect class="b2" x="'+x+'" y="'+y+'" width="'+bw+'" height="'+h+'" rx="2"/>';}
    const tot=r.baru+r.mur;
    if(tot>0&&slot>=16)s+='<text class="vl" x="'+cx+'" y="'+(y-4)+'" text-anchor="middle">'+fmtN(tot)+'</text>';
    s+='<text class="xl'+(r.cur?' cur':'')+'" x="'+cx+'" y="'+(H-9)+'" text-anchor="middle">'+esc(r.short)+'</text>';
  });
  return s+'</svg>';
}
function renderRekap(){
  const mode=ui.rmode,metric=ui.rmetric;
  const rows=aggregate(mode,metric);
  const unit={quran:'halaman',ayat:'ayat',matan:'bait'}[metric];
  const cy=new Date().getFullYear();
  // navigasi tahun dan bulan
  $('rNav').hidden=mode==='year';
  $('rYear').textContent=ui.ryear;
  $('rPrev').disabled=ui.ryear<=2000;
  $('rNext').disabled=ui.ryear>=cy;
  $('rMonth').hidden=mode!=='day';
  $('rNote').hidden=mode!=='week';
  $('rMonth').value=String(ui.rmonth);
  // total pada cakupan yang dipilih
  const src=metricSrc(metric);
  let prefix='',scope;
  if(mode==='day'){prefix=ui.ryear+'-'+pad(ui.rmonth+1);scope='Total '+MONTHS[ui.rmonth]+' '+ui.ryear;}
  else if(mode==='year'){scope='Total seluruh tahun';}
  else{prefix=String(ui.ryear);scope='Total '+ui.ryear;}
  let tb=0,tm=0;
  src.forEach(e=>{
    if(prefix&&e.date.indexOf(prefix)!==0)return;
    const v=metricVal(metric,e);
    if(e.type==='baru')tb+=v;else tm+=v;
  });
  $('rCur').innerHTML='<div><small>'+scope+': hafalan baru</small><b>'+fmtN(tb)+'<span>'+unit+'</span></b></div><div><small>'+scope+": muraja'ah</small><b>"+fmtN(tm)+'<span>'+unit+'</span></b></div>';
  const box=$('rChart');
  const W=Math.max(280,box.clientWidth||320);
  const modeName={day:'harian',week:'mingguan',month:'bulanan',year:'tahunan'}[mode];
  const periodName=mode==='day'?' '+MONTHS[ui.rmonth]+' '+ui.ryear:(mode==='year'?'':' '+ui.ryear);
  box.innerHTML=chartSVG(rows,W,'Grafik batang '+modeName+periodName+' untuk '+metricName(metric));
  let t='<table class="rt"><thead><tr><th scope="col">Periode</th><th scope="col">Baru</th><th scope="col">Muraja\'ah</th></tr></thead><tbody>';
  rows.filter(r=>!r.future).reverse().forEach(r=>{
    t+='<tr'+(r.cur?' class="cur"':'')+'><td>'+esc(r.label)+'</td><td class="'+(r.baru?'':'z')+'">'+(r.baru?fmtN(r.baru):'–')+'</td><td class="'+(r.mur?'':'z')+'">'+(r.mur?fmtN(r.mur):'–')+'</td></tr>';
  });
  $('rTable').innerHTML=t+'</tbody></table>';
  const mn={
    db:'Datamu tersimpan di akun Claude dan bisa dibuka dari perangkat lain. Ekspor cadangan secara berkala sebagai salinan tambahan.',
    sheets:'Datamu tersimpan di Google Sheet milikmu sendiri dan bisa dibuka dari perangkat lain yang memakai URL Apps Script yang sama. Ekspor cadangan secara berkala sebagai salinan tambahan.',
    local:'Penyimpanan akun tidak tersedia di sini, jadi data hanya tersimpan di browser ini. Ekspor cadangan agar tidak hilang.',
    memory:'Data tidak bisa disimpan permanen di sini. Ekspor cadangan sebelum menutup halaman.'
  }[Persist.mode];
  $('bkMode').textContent=mn;
  $('bkChangeMethod').hidden=!Persist.viaChoice;
  $('bkSheetEmail').hidden=!(Persist.mode==='sheets'&&Persist.sheetEmail);
  if(Persist.mode==='sheets'&&Persist.sheetEmail)$('bkSheetEmailT').textContent=Persist.sheetEmail;
}

/* ---------- Rapot PDF ---------- */
/* Total baru/muraja'ah pada periode SEBELUM periode rapot saat ini, untuk indikator tren.
   mode 'year' (seluruh tahun/all-time) tidak punya padanan "periode sebelumnya" yang jelas, jadi dilewati. */
function prevPeriodTotals(mode,metric,ryear,rmonth){
  if(mode==='year')return null;
  let prefix;
  if(mode==='day'){
    let py=ryear,pm=rmonth-1;
    if(pm<0){pm=11;py--;}
    prefix=py+'-'+pad(pm+1);
  }else{
    prefix=String(ryear-1);
  }
  let baru=0,mur=0;
  metricSrc(metric).forEach(e=>{
    if(e.date.indexOf(prefix)!==0)return;
    const v=metricVal(metric,e);
    if(e.type==='baru')baru+=v;else mur+=v;
  });
  return{baru:baru,mur:mur};
}
function buildRapotData(){
  const mode=ui.rmode,metric=ui.rmetric;
  const unit={quran:'halaman',ayat:'ayat',matan:'bait'}[metric];
  const rows=aggregate(mode,metric).filter(r=>!r.future);
  const src=metricSrc(metric);
  let prefix='',scope;
  if(mode==='day'){prefix=ui.ryear+'-'+pad(ui.rmonth+1);scope='Total '+MONTHS[ui.rmonth]+' '+ui.ryear;}
  else if(mode==='year'){scope='Total seluruh tahun';}
  else{prefix=String(ui.ryear);scope='Total '+ui.ryear;}
  let totalBaru=0,totalMur=0;
  const activeDays=new Set();
  src.forEach(e=>{
    if(prefix&&e.date.indexOf(prefix)!==0)return;
    const v=metricVal(metric,e);
    if(e.type==='baru'){totalBaru+=v;activeDays.add(e.date);}else totalMur+=v;
  });
  const modeName={day:'Harian',week:'Mingguan',month:'Bulanan',year:'Tahunan'}[mode];
  const periodLabel=mode==='day'?(MONTHS[ui.rmonth]+' '+ui.ryear):(mode==='year'?'Seluruh tahun':String(ui.ryear));
  const prevLabel=mode==='day'?'bulan lalu':(mode==='year'?null:'tahun lalu');
  const prevTotals=prevPeriodTotals(mode,metric,ui.ryear,ui.rmonth);
  const trendBaru=(prevTotals&&prevTotals.baru>0)?(totalBaru-prevTotals.baru)/prevTotals.baru:null;
  const trendMur=(prevTotals&&prevTotals.mur>0)?(totalMur-prevTotals.mur)/prevTotals.mur:null;
  return{
    name:activeDisplayName(),
    generatedAt:todayS(),
    mode:mode,modeName:modeName,
    metric:metric,metricLabel:metricName(metric),unit:unit,
    periodLabel:periodLabel,scope:scope,
    totalBaru:totalBaru,totalMur:totalMur,
    prevLabel:prevLabel,trendBaru:trendBaru,trendMur:trendMur,
    activeDays:activeDays.size,avgPerDay:activeDays.size?totalBaru/activeDays.size:0,
    juz:buildJuzProgress(),
    rows:rows.map(r=>({label:r.label,baru:r.baru,mur:r.mur}))
  };
}
const fmtDateFull=s=>{const d=parseD(s);return d.getDate()+' '+MONTHS[d.getMonth()]+' '+d.getFullYear();};
function renderRapotPdf(data,sections){
  sections=sections||{cards:true,juz:true,table:true,quote:true,signature:true};
  const J=window.jspdf&&window.jspdf.jsPDF;
  if(!J)throw new Error('jsPDF belum termuat');
  const doc=new J({unit:'mm',format:'a4'});
  const pageW=doc.internal.pageSize.getWidth();
  const pageH=doc.internal.pageSize.getHeight();
  const margin=18;
  const addFooter=()=>{
    const n=doc.internal.getNumberOfPages();
    for(let i=1;i<=n;i++){
      doc.setPage(i);
      // Bingkai emas ganda
      doc.setDrawColor(164,127,40);doc.setLineWidth(.5);doc.rect(4,4,pageW-8,pageH-8);
      doc.setLineWidth(.2);doc.rect(6.5,6.5,pageW-13,pageH-13);
      doc.setFont('helvetica','normal');doc.setFontSize(8);doc.setTextColor(140,140,132);
      doc.text('Catatan Hafalan',margin,pageH-10);
      doc.text('Halaman '+i+' dari '+n,pageW-margin,pageH-10,{align:'right'});
    }
  };
  // Pembatas dekoratif (garis-titik-garis) antar bagian besar halaman
  const ornament=cy=>{
    doc.setDrawColor(164,127,40);doc.setLineWidth(.4);
    doc.line(margin,cy,pageW/2-10,cy);doc.line(pageW/2+10,cy,pageW-margin,cy);
    doc.setFillColor(164,127,40);doc.circle(pageW/2,cy,1.3,'F');doc.setLineWidth(.2);
  };
  // Kop hijau
  const kopH=42;
  doc.setFillColor(14,74,59);
  doc.rect(0,0,pageW,kopH,'F');
  // Medali lambang (vektor murni, aman lintas font)
  {
    const cx=pageW/2,cy=8.5,r=5.2;
    doc.setDrawColor(221,187,99);doc.setLineWidth(.6);doc.circle(cx,cy,r,'S');
    doc.setLineWidth(.3);doc.circle(cx,cy,r*0.65,'S');
    doc.setFillColor(221,187,99);doc.circle(cx,cy,0.9,'F');
  }
  doc.setTextColor(246,242,226);
  doc.setFont('times','bold');doc.setFontSize(21);
  doc.text('Rapot Hafalan',margin,17);
  doc.setFont('helvetica','normal');doc.setFontSize(10.5);
  doc.setTextColor(221,187,99);
  doc.text(data.scope,margin,25);
  doc.setTextColor(230,232,220);doc.setFontSize(8.5);
  doc.text('Dicetak '+fmtDateFull(data.generatedAt),margin,31);
  // Badge total kumulatif halaman & juz (terpisah dari angka periode di bawahnya)
  const pill=(x,py,w,h,text)=>{
    doc.setDrawColor(221,187,99);doc.setLineWidth(.4);
    doc.roundedRect(x,py,w,h,h/2,h/2,'S');
    doc.setFont('helvetica','bold');doc.setFontSize(7.5);doc.setTextColor(221,187,99);
    doc.text(text,x+w/2,py+h/2+1.4,{align:'center'});
  };
  pill(margin,35,46,7,data.juz.totalPagesFull+'/'+data.juz.totalPagesAll+' halaman');
  pill(margin+50,35,32,7,data.juz.juzDone+'/30 juz');
  if(data.name){
    doc.setFont('helvetica','bold');doc.setFontSize(10.5);doc.setTextColor(246,242,226);
    doc.text(data.name,pageW-margin,17,{align:'right'});
    doc.setFont('helvetica','normal');doc.setFontSize(8.5);doc.setTextColor(221,187,99);
    doc.text(data.modeName+' · '+data.metricLabel,pageW-margin,25,{align:'right'});
  }
  // Kartu ringkasan (baru, muraja'ah, rata-rata harian) + indikator tren
  let y=kopH+12;
  if(sections.cards){
    const gap=6,boxW=(pageW-margin*2-gap*2)/3,boxH=27;
    const trendInfo=t=>{
      if(t==null||!data.prevLabel)return null;
      const pct=Math.round(t*100);
      return{up:pct>=0,text:(pct>=0?'↑ ':'↓ ')+Math.abs(pct)+'% dari '+data.prevLabel};
    };
    const card=(x,label,value,trend)=>{
      doc.setDrawColor(219,222,208);doc.setFillColor(251,250,244);
      doc.roundedRect(x,y,boxW,boxH,2.2,2.2,'FD');
      doc.setFont('helvetica','normal');doc.setFontSize(8.5);doc.setTextColor(88,108,99);
      doc.text(label,x+6,y+9);
      doc.setFont('times','bold');doc.setFontSize(15);doc.setTextColor(14,74,59);
      doc.text(value,x+6,y+18.5);
      if(trend){
        trend.up?doc.setTextColor(23,112,90):doc.setTextColor(165,69,47);
        doc.setFont('helvetica','normal');doc.setFontSize(7);
        doc.text(trend.text,x+6,y+25);
      }
    };
    card(margin,'Hafalan baru',fmtN(data.totalBaru)+' '+data.unit,trendInfo(data.trendBaru));
    card(margin+boxW+gap,"Muraja'ah",fmtN(data.totalMur)+' '+data.unit,trendInfo(data.trendMur));
    {
      const x=margin+2*(boxW+gap);
      doc.setDrawColor(219,222,208);doc.setFillColor(237,225,188);
      doc.roundedRect(x,y,boxW,boxH,2.2,2.2,'FD');
      doc.setFont('helvetica','normal');doc.setFontSize(8.5);doc.setTextColor(122,93,18);
      doc.text('Rata-rata harian',x+6,y+9);
      doc.setFont('times','bold');doc.setFontSize(15);doc.setTextColor(122,93,18);
      doc.text(fmtN(data.avgPerDay)+' '+data.unit,x+6,y+18.5);
      doc.setFont('helvetica','normal');doc.setFontSize(7);doc.setTextColor(122,93,18);
      doc.text(data.activeDays+' hari aktif',x+6,y+25);
    }
    y+=boxH+11;
    // Progres khataman keseluruhan (kumulatif, tidak terikat filter periode)
    doc.setFont('helvetica','bold');doc.setFontSize(9.5);doc.setTextColor(16,35,29);
    doc.text('Progres khataman keseluruhan',margin,y);
    y+=6;
    const barW=pageW-margin*2,barH=4.5;
    doc.setFillColor(233,235,223);
    doc.roundedRect(margin,y,barW,barH,barH/2,barH/2,'F');
    const pgPct=data.juz.totalPagesAll?data.juz.totalPagesFull/data.juz.totalPagesAll:0;
    doc.setFillColor(14,74,59);
    doc.roundedRect(margin,y,Math.max(barH,barW*pgPct),barH,barH/2,barH/2,'F');
    y+=barH+5;
    doc.setFont('helvetica','normal');doc.setFontSize(8);doc.setTextColor(88,108,99);
    doc.text(data.juz.totalPagesFull+' dari '+data.juz.totalPagesAll+' halaman ('+Math.round(pgPct*100)+'%)',margin,y);
    doc.text(data.juz.juzDone+' dari 30 juz tuntas',pageW-margin,y,{align:'right'});
    y+=13;
  }
  if(sections.table){
    if(sections.cards){ornament(y);y+=10;}
    // Judul tabel
    doc.setFont('helvetica','bold');doc.setFontSize(11.5);doc.setTextColor(16,35,29);
    doc.text('Rincian per periode ('+data.modeName+')',margin,y);
    y+=4;doc.setDrawColor(164,127,40);doc.setLineWidth(.6);doc.line(margin,y,pageW-margin,y);doc.setLineWidth(.2);
    y+=10;
    const colP=margin,colB=pageW-margin-58,colM=pageW-margin-24;
    const header=()=>{
      doc.setFillColor(11,55,45);doc.rect(margin,y-5.5,pageW-margin*2,8,'F');
      doc.setFont('helvetica','bold');doc.setFontSize(8.5);doc.setTextColor(221,187,99);
      doc.text('PERIODE',colP+2,y);doc.text('BARU',colB,y);doc.text("MURAJA'AH",colM,y);
      y+=9;
    };
    header();
    doc.setFont('helvetica','normal');doc.setFontSize(9.5);
    if(!data.rows.length){
      doc.setTextColor(88,108,99);doc.text('Belum ada data pada periode ini.',colP,y);y+=7;
    }
    data.rows.forEach((r,idx)=>{
      if(y>pageH-28){doc.addPage();y=20;header();doc.setFont('helvetica','normal');doc.setFontSize(9.5);}
      if(idx%2===0){doc.setFillColor(247,242,226);doc.rect(margin,y-5,pageW-margin*2,7,'F');}
      doc.setTextColor(16,35,29);doc.text(String(r.label),colP,y);
      if(r.baru)doc.setTextColor(23,112,90);else doc.setTextColor(190,190,182);
      doc.text(r.baru?fmtN(r.baru):'–',colB,y);
      if(r.mur)doc.setTextColor(164,127,40);else doc.setTextColor(190,190,182);
      doc.text(r.mur?fmtN(r.mur):'–',colM,y);
      y+=7;
    });
    if(y>pageH-32){doc.addPage();y=24;}
    y+=2;doc.setFillColor(237,225,188);doc.rect(margin,y-5.5,pageW-margin*2,8,'F');
    doc.setFont('helvetica','bold');doc.setFontSize(9.5);doc.setTextColor(122,93,18);
    doc.text('Total',colP+2,y);doc.text(fmtN(data.totalBaru),colB,y);doc.text(fmtN(data.totalMur),colM,y);
    y+=13;
  }
  if(sections.juz){
    // Halaman baru: Peta juz
    doc.addPage();y=22;
    doc.setFont('helvetica','bold');doc.setFontSize(13);doc.setTextColor(16,35,29);
    doc.text('Peta juz',margin,y);
    y+=4;doc.setDrawColor(164,127,40);doc.setLineWidth(.6);doc.line(margin,y,pageW-margin,y);doc.setLineWidth(.2);
    y+=8;
    const jzColor={tuntas:[14,74,59],berjalan:[237,225,188],belum:[233,235,223]};
    const jzText={tuntas:[246,242,226],berjalan:[122,93,18],belum:[136,135,128]};
    const cols=6,cGap=3,cellW=(pageW-margin*2-cGap*(cols-1))/cols,cellH=13;
    data.juz.rows.forEach((r,i)=>{
      const col=i%cols,row=Math.floor(i/cols);
      const x=margin+col*(cellW+cGap),cy=y+row*(cellH+cGap);
      const f=jzColor[r.status],t=jzText[r.status];
      doc.setFillColor(f[0],f[1],f[2]);
      doc.roundedRect(x,cy,cellW,cellH,2,2,'F');
      doc.setFont('helvetica','bold');doc.setFontSize(9);doc.setTextColor(t[0],t[1],t[2]);
      doc.text(String(r.juz),x+cellW/2,cy+cellH/2+3,{align:'center'});
    });
    y+=Math.ceil(30/cols)*(cellH+cGap)+6;
    let lx=margin;
    doc.setFont('helvetica','normal');doc.setFontSize(7.5);
    [['Tuntas',jzColor.tuntas],['Sedang dihafal',jzColor.berjalan],['Belum',jzColor.belum]].forEach(([label,c])=>{
      doc.setFillColor(c[0],c[1],c[2]);doc.rect(lx,y-3,3.5,3.5,'F');
      doc.setTextColor(88,108,99);doc.text(label,lx+5.5,y);
      lx+=5.5+doc.getTextWidth(label)+8;
    });
    y+=14;
    // Rincian per juz
    doc.setFont('helvetica','bold');doc.setFontSize(13);doc.setTextColor(16,35,29);
    doc.text('Rincian per juz',margin,y);
    y+=4;doc.setDrawColor(164,127,40);doc.setLineWidth(.6);doc.line(margin,y,pageW-margin,y);doc.setLineWidth(.2);
    y+=8;
    const jColJ=margin,jBarX=margin+18,jBarW=88,jColHal=jBarX+jBarW+8,jColStat=pageW-margin-24;
    const statusLabel={tuntas:'Tuntas',berjalan:'Berjalan',belum:'Belum'};
    const statusColor={tuntas:[23,112,90],berjalan:[164,127,40],belum:[180,180,172]};
    const jHeader=()=>{
      doc.setFillColor(11,55,45);doc.rect(margin,y-5.5,pageW-margin*2,8,'F');
      doc.setFont('helvetica','bold');doc.setFontSize(8.5);doc.setTextColor(221,187,99);
      doc.text('JUZ',jColJ+2,y);doc.text('PROGRES',jBarX,y);doc.text('HALAMAN',jColHal,y);doc.text('STATUS',jColStat,y);
      y+=9;
    };
    jHeader();
    data.juz.rows.forEach(r=>{
      if(y>pageH-24){doc.addPage();y=20;jHeader();}
      doc.setFont('helvetica','normal');doc.setFontSize(8.5);doc.setTextColor(16,35,29);
      doc.text('Juz '+r.juz,jColJ,y);
      const bh=2.6;
      doc.setFillColor(233,235,223);doc.roundedRect(jBarX,y-2.8,jBarW,bh,bh/2,bh/2,'F');
      const fw=jBarW*r.pct;
      if(fw>0){doc.setFillColor(14,74,59);doc.roundedRect(jBarX,y-2.8,Math.max(bh,fw),bh,bh/2,bh/2,'F');}
      doc.setTextColor(88,108,99);doc.text(r.full+'/'+r.total,jColHal,y);
      const sc=statusColor[r.status];doc.setTextColor(sc[0],sc[1],sc[2]);doc.text(statusLabel[r.status],jColStat,y);
      y+=8;
    });
    y+=4;
    if(y>pageH-34){doc.addPage();y=24;}
    doc.setFillColor(237,225,188);
    doc.roundedRect(margin,y-6,pageW-margin*2,22,2.5,2.5,'F');
    doc.setFont('helvetica','bold');doc.setFontSize(9.5);doc.setTextColor(122,93,18);
    doc.text('Total keseluruhan',margin+6,y+2);
    doc.setFont('helvetica','normal');doc.setFontSize(8.5);
    doc.text(data.juz.doneCount+' tuntas · '+data.juz.ongoingCount+' berjalan · '+data.juz.noneCount+' belum dari 30 juz',margin+6,y+11);
    doc.setFont('times','bold');doc.setFontSize(13);doc.setTextColor(14,74,59);
    doc.text(data.juz.totalPagesFull+'/'+data.juz.totalPagesAll+' halaman',pageW-margin-6,y+6,{align:'right'});
    y+=32;
  }
  if(sections.quote||sections.signature){
    if(y>pageH-46){doc.addPage();y=40;}
    ornament(y);y+=10;
    if(sections.quote){
      doc.setFont('times','italic');doc.setFontSize(9.5);doc.setTextColor(122,93,18);
      doc.text('"Jagalah Al-Qur\'an, sungguh ia lebih mudah lepas daripada unta di talinya."',pageW/2,y,{align:'center'});
      y+=26;
    }
    if(sections.signature){
      doc.setDrawColor(180,178,169);doc.setLineWidth(.3);
      doc.line(pageW-margin-92,y,pageW-margin,y);
      doc.setFont('helvetica','normal');doc.setFontSize(8);doc.setTextColor(122,93,18);
      doc.text('Paraf pembimbing',pageW-margin-92,y+6);
    }
  }
  addFooter();
  return doc;
}
async function generateRapotPdf(){
  const picked=await askRapotOptions();
  if(!picked)return;
  const{sections,santriIds}=picked;
  const targets=(MS&&santriIds&&santriIds.length)?santriIds:[MS?MS.activeSantriId:null];
  // Bangun semua dokumen PDF dulu secara SINKRON (tanpa await di antaranya):
  // buildRapotData()/mem() membaca S global, jadi selama proses ini S ditukar
  // sementara ke data santri lain lalu dikembalikan sebelum kontrol balik ke
  // browser — supaya tidak ada jendela waktu tampilan sempat "kelihatan"
  // data santri yang salah.
  const origQ=S.quran,origM=S.matan,origL=S.matanLog;
  const jobs=[];
  targets.forEach(sid=>{
    let name=activeDisplayName();
    const isOther=!!(MS&&sid&&sid!==MS.activeSantriId);
    if(isOther){
      const rec=MS.santriData[sid]||emptySantriRecord();
      S.quran=rec.quran;S.matan=rec.matan;S.matanLog=rec.matanLog;memVer++;
      const s=MS.santriList.find(x=>x.id===sid);
      name=s?s.nama:'';
    }
    const data=buildRapotData();
    if(MS)data.name=name;
    if(isOther){S.quran=origQ;S.matan=origM;S.matanLog=origL;memVer++;}
    try{jobs.push({name:name,doc:renderRapotPdf(data,sections)});}
    catch(e){/* santri ini dilewati kalau gagal dirender, sisanya tetap lanjut */}
  });
  if(!jobs.length){toast('Gagal membuat PDF: coba lagi');return;}
  let dl=null;
  try{dl=window.claude&&typeof window.claude.use==='function'?await window.claude.use('downloads'):null;}catch(e){}
  let saved=0,shown=0;
  for(const job of jobs){
    const slug=(job.name||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
    const filename='rapot-hafalan-'+(slug?slug+'-':'')+todayS()+'.pdf';
    if(dl){
      try{await dl.save({filename:filename,data:job.doc.output('blob')});saved++;continue;}
      catch(e){if(e&&e.code==='declined')continue;}
    }
    try{job.doc.output('dataurlnewwindow');shown++;}
    catch(e){/* beberapa browser memblokir tab baru; abaikan, PDF tetap sudah dibuat */}
  }
  if(saved)toast(saved>1?'Rapot PDF disimpan ('+saved+' santri)':'Rapot PDF disimpan');
  else if(shown)toast('Unduhan tidak tersedia. Rapot PDF ditampilkan di tab baru.');
}

/* ---------- Cadangan ---------- */
function buildExport(){
  return JSON.stringify({app:'catatan-hafalan',version:1,exportedAt:new Date().toISOString(),quran:S.quran.map(persistQ),matan:S.matan,matanLog:S.matanLog},null,1);
}
async function exportData(){
  const payload=buildExport();
  let dl=null;
  try{dl=window.claude&&typeof window.claude.use==='function'?await window.claude.use('downloads'):null;}catch(e){}
  if(dl){
    try{await dl.save({filename:'catatan-hafalan-'+todayS()+'.json',data:payload});toast('Cadangan disimpan');return;}
    catch(e){if(e&&e.code==='declined')return;}
  }
  $('bkText').value=payload;$('bkDetails').open=true;
  toast('Unduhan tidak tersedia. Salin teks cadangan di bawah.');
}
async function importText(text){
  let data;
  try{data=JSON.parse(text);}catch(e){toast('File bukan JSON yang valid');return;}
  if(!data||typeof data!=='object'||(!Array.isArray(data.quran)&&!Array.isArray(data.matan)&&!Array.isArray(data.matanLog))){toast('Format cadangan tidak dikenali');return;}
  const c=cleanState(data);
  const c1=await ask({title:'Ganti data dengan cadangan?',body:'Cadangan berisi '+c.quran.length+' setoran Quran, '+c.matan.length+' matan, dan '+c.matanLog.length+' setoran matan'+(c.skipped?' ('+c.skipped+' baris rusak dilewati)':'')+'. Data yang ada sekarang akan diganti seluruhnya.',
    actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Ganti data',value:'go',kind:'danger'}]});
  if(c1!=='go')return;
  const oq=S.quran,ol=S.matanLog;
  applyState(c);ui.matanId=null;ui.juz=null;
  markAllDirty(oq,ol);
  prefillQuran();renderAll();toast('Cadangan dipulihkan');
}

/* ---------- Render semua ---------- */
function renderAll(){
  renderDash();renderJuz();renderSurat();renderQHist();renderMatan();
  if(ui.view==='rekap')renderRekap();
}

/* ---------- Event ---------- */
function bind(){
  document.querySelectorAll('.nav-i').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));
  document.addEventListener('click',e=>{
    const t=e.target.closest('[data-go]');if(t){showView(t.dataset.go);return;}
    const om=e.target.closest('[data-open-matan]');if(om){selectMatan(om.dataset.openMatan);showView('matan');return;}
    if(e.target.closest('#dashAddMatan')||e.target.closest('[data-add-matan]')){openMatanDlg('add');return;}
  });
  $('statusRetry').addEventListener('click',()=>{if(dirty.size){scheduleFlush();}else setSave('saved');});
  // Quran
  AY.forEach((n,i)=>{
    ['a-ss','a-es','surSel','surSelEnd'].forEach(id=>{
      const o=document.createElement('option');o.value=String(i+1);o.textContent=(i+1)+'. '+SN[i]+' ('+n+' ayat)';$(id).appendChild(o);
    });
  });
  ['a-ss','a-es'].forEach(id=>{const o=document.createElement('option');o.value='';o.textContent='Pilih surat';$(id).insertBefore(o,$(id).firstChild);$(id).value='';});
  {const o=document.createElement('option');o.value='';o.textContent='Pilih surat';$('surSel').insertBefore(o,$('surSel').firstChild);$('surSel').value='';}
  {const o=document.createElement('option');o.value='';o.textContent='Pilih surat';$('surSelEnd').insertBefore(o,$('surSelEnd').firstChild);$('surSelEnd').value='';}
  const clearPicks=()=>{if(ui.sel||ui.crossRange){ui.sel=null;ui.crossRange=null;ui.juzE=null;ui.selE=null;renderJuz();}if(ui.selA||ui.crossRangeA){ui.selA=null;ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;renderSurat();}};
  ['sj','sp','ej','ep'].forEach(k=>qEl[k].addEventListener('input',()=>{updateQ();clearPicks();}));
  ['sa','ea'].forEach(k=>aEl[k].addEventListener('input',()=>{updateQ();clearPicks();}));
  ['ss','es'].forEach(k=>['input','change'].forEach(ev=>aEl[k].addEventListener(ev,()=>{
    if(k==='ss'&&!aEl.es.value)aEl.es.value=aEl.ss.value;
    updateQ();clearPicks();
  })));
  qEl.date.addEventListener('input',updateQ);
  document.querySelectorAll('input[name="q-type"]').forEach(r=>r.addEventListener('change',updateQ));
  document.querySelectorAll('input[name="q-mode"]').forEach(r=>r.addEventListener('change',()=>setQMode(r.value)));
  document.querySelectorAll('input[name="map-mode"]').forEach(r=>r.addEventListener('change',()=>setMapMode(r.value)));
  $('qManualShortcut').addEventListener('click',()=>{
    if(ui.mapMode==='surat'){setQMode('ayat');aEl.ss.focus();}
    else{setQMode('page');qEl.sj.focus();}
    $('qForm').scrollIntoView({behavior:'smooth',block:'start'});
  });
  $('qForm').addEventListener('submit',e=>{e.preventDefault();saveQuran();});
  $('jmap').addEventListener('click',e=>{const b=e.target.closest('.jt');if(!b)return;const j=Number(b.dataset.j);ui.juz=ui.juz===j?null:j;if(!ui.juz||(ui.sel&&ui.sel.j!==ui.juz)){ui.sel=null;ui.crossRange=null;ui.juzE=null;ui.selE=null;prefillQuran();}renderJuz();});
  $('juzDetail').addEventListener('click',e=>{
    const pb=e.target.closest('.pg');
    if(pb){
      const p=Number(pb.dataset.p),j=ui.juz,s0=ui.sel;
      if(!s0||s0.j!==j){ui.sel={j:j,a:p,b:p,picking:true};ui.crossRange=null;ui.juzE=null;ui.selE=null;}
      else if(s0.picking)ui.sel=(p===s0.a)?null:{j:j,a:Math.min(s0.a,p),b:Math.max(s0.a,p),picking:false};
      else {ui.sel={j:j,a:p,b:p,picking:true};ui.crossRange=null;ui.juzE=null;ui.selE=null;}
      if(!ui.sel||!ui.sel.picking){ui.crossRange=null;ui.juzE=null;ui.selE=null;}
      if(ui.sel){
        setQMode('page');
        qEl.sj.value=j;qEl.ej.value=j;qEl.sp.value=ui.sel.a;qEl.ep.value=ui.sel.b;updateQ();
      }else prefillQuran();
      renderJuz();
      const again=document.querySelector('#juzDetail .pg[data-p="'+p+'"]');if(again)again.focus();
      return;
    }
    if(e.target.closest('[data-clear-sel]')){ui.sel=null;ui.crossRange=null;ui.juzE=null;ui.selE=null;prefillQuran();renderJuz();return;}
    if(e.target.closest('[data-go-form]')){$('qForm').scrollIntoView({behavior:'smooth',block:'start'});return;}
    const b=e.target.closest('[data-start-juz]');if(!b)return;
    ui.sel=null;ui.crossRange=null;ui.juzE=null;ui.selE=null;
    const j=Number(b.dataset.startJuz),M=mem(),n=juzPages(j);
    let p=1;for(let i=1;i<=n;i++){if(!M.full[gp(j,i)]){p=i;break;}}
    document.querySelector('input[name="q-type"][value="baru"]').checked=true;
    setQMode('page');
    qEl.sj.value=j;qEl.sp.value=p;qEl.ej.value=j;qEl.ep.value='';updateQ();
    qEl.ep.focus();qEl.ep.scrollIntoView({block:'center',behavior:'smooth'});
  });
  $('jmapEnd').addEventListener('click',e=>{
    const b=e.target.closest('.jt');if(!b)return;
    const j=Number(b.dataset.j);ui.juzE=ui.juzE===j?null:j;renderJuzEnd();
  });
  $('juzDetailEnd').addEventListener('click',e=>{
    const pb=e.target.closest('.pg');if(!pb)return;
    if(!ui.sel||!ui.sel.picking)return;
    const p=Number(pb.dataset.p),j=ui.juzE;
    if(ui.selE&&ui.selE.j===j&&ui.selE.a===p){
      ui.selE=null;ui.crossRange=null;
    }else{
      ui.selE={j:j,a:p,b:p,picking:false};
      ui.crossRange={sj:ui.sel.j,sp:ui.sel.a,ej:j,ep:p};
      setQMode('page');
      qEl.sj.value=ui.sel.j;qEl.sp.value=ui.sel.a;qEl.ej.value=j;qEl.ep.value=p;updateQ();
    }
    renderJuz();
    const again=document.querySelector('#juzDetailEnd .pg[data-p="'+p+'"]');if(again)again.focus();
  });
  $('smap').addEventListener('click',e=>{const b=e.target.closest('.jt');if(!b)return;const s=Number(b.dataset.s);ui.surah=ui.surah===s?null:s;if(!ui.surah||(ui.selA&&ui.selA.s!==ui.surah)){ui.selA=null;ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;prefillQuran();}renderSurat();});
  $('surSel').addEventListener('change',e=>{const s=e.target.value?Number(e.target.value):null;ui.surah=s;if(!s||(ui.selA&&ui.selA.s!==s)){ui.selA=null;ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;prefillQuran();}renderSurat();});
  $('suratDetail').addEventListener('click',e=>{
    const ab=e.target.closest('.bt');
    if(ab){
      const a=Number(ab.dataset.a),s=ui.surah,s0=ui.selA;
      if(!s0||s0.s!==s){ui.selA={s:s,a:a,b:a,picking:true};ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;}
      else if(s0.picking)ui.selA=(a===s0.a)?null:{s:s,a:Math.min(s0.a,a),b:Math.max(s0.a,a),picking:false};
      else {ui.selA={s:s,a:a,b:a,picking:true};ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;}
      if(!ui.selA||!ui.selA.picking){ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;}
      if(ui.selA){
        setQMode('ayat');
        aEl.ss.value=String(s);aEl.es.value=String(s);aEl.sa.value=ui.selA.a;aEl.ea.value=ui.selA.b;updateQ();
      }else prefillQuran();
      renderSurat();
      const again=document.querySelector('#suratDetail .bt[data-a="'+a+'"]');if(again)again.focus();
      return;
    }
    if(e.target.closest('[data-clear-sel]')){ui.selA=null;ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;prefillQuran();renderSurat();return;}
    if(e.target.closest('[data-go-form]')){$('qForm').scrollIntoView({behavior:'smooth',block:'start'});return;}
    const b=e.target.closest('[data-start-sur]');if(!b)return;
    ui.selA=null;ui.crossRangeA=null;ui.surahE=null;ui.selAE=null;
    const s=Number(b.dataset.startSur),M=mem(),n=AY[s-1];
    let a=1;for(let i=1;i<=n;i++){if(!M.flag[gAyah(s,i)]){a=i;break;}}
    document.querySelector('input[name="q-type"][value="baru"]').checked=true;
    setQMode('ayat');
    aEl.ss.value=String(s);aEl.sa.value=a;aEl.es.value=String(s);aEl.ea.value='';updateQ();
    aEl.ea.focus();aEl.ea.scrollIntoView({block:'center',behavior:'smooth'});
  });
  $('smapEnd').addEventListener('click',e=>{
    const b=e.target.closest('.jt');if(!b)return;
    const s=Number(b.dataset.s);ui.surahE=ui.surahE===s?null:s;renderSuratEnd();
  });
  $('surSelEnd').addEventListener('change',e=>{const s=e.target.value?Number(e.target.value):null;ui.surahE=s;renderSuratEnd();});
  $('suratDetailEnd').addEventListener('click',e=>{
    const ab=e.target.closest('.bt');if(!ab)return;
    if(!ui.selA||!ui.selA.picking)return;
    const a=Number(ab.dataset.a),s=ui.surahE;
    if(ui.selAE&&ui.selAE.s===s&&ui.selAE.a===a){
      ui.selAE=null;ui.crossRangeA=null;
    }else{
      ui.selAE={s:s,a:a,b:a,picking:false};
      ui.crossRangeA={ss:ui.selA.s,sa:ui.selA.a,es:s,ea:a};
      setQMode('ayat');
      aEl.ss.value=String(ui.selA.s);aEl.sa.value=ui.selA.a;aEl.es.value=String(s);aEl.ea.value=a;updateQ();
    }
    renderSurat();
    const again=document.querySelector('#suratDetailEnd .bt[data-a="'+a+'"]');if(again)again.focus();
  });
  $('qHist').addEventListener('click',e=>{
    const d=e.target.closest('[data-del-q]');if(d){delQuran(d.dataset.delQ);return;}
    if(e.target.closest('#qMore')){ui.qShown+=15;renderQHist();}
  });
  // Matan
  $('mAdd').addEventListener('click',()=>openMatanDlg('add'));
  $('mList').addEventListener('click',e=>{
    const r=e.target.closest('[data-m]');if(r){selectMatan(r.dataset.m);return;}
    if(e.target.closest('[data-add-matan]'))openMatanDlg('add');
  });
  ['from','to'].forEach(k=>mEl[k].addEventListener('input',updateM));
  mEl.date.addEventListener('input',updateM);
  document.querySelectorAll('input[name="m-type"]').forEach(r=>r.addEventListener('change',updateM));
  $('mForm').addEventListener('submit',e=>{e.preventDefault();saveMatanEntry();});
  $('mDetail').addEventListener('click',e=>{
    const b=e.target.closest('.bt');
    if(b){
      const bd=Number(b.dataset.b),s0=ui.selM;
      if(!s0)ui.selM={a:bd,b:bd,picking:true};
      else if(s0.picking)ui.selM=(bd===s0.a)?null:{a:Math.min(s0.a,bd),b:Math.max(s0.a,bd),picking:false};
      else ui.selM={a:bd,b:bd,picking:true};
      if(ui.selM){mEl.from.value=ui.selM.a;mEl.to.value=ui.selM.b;updateM();}
      else prefillMatan();
      renderMatan();
      return;
    }
    const a=e.target.closest('[data-act]');
    if(a){if(a.dataset.act==='edit')openMatanDlg('edit');else delMatan();}
  });
  $('mHist').addEventListener('click',e=>{
    const d=e.target.closest('[data-del-m]');if(d){delMatanEntry(d.dataset.delM);return;}
    if(e.target.closest('#mMore')){ui.mShown+=15;renderMatan();}
  });
  $('mdForm').addEventListener('submit',submitMatanDlg);
  $('md-cancel').addEventListener('click',()=>mdlg.close());
  // Santri (Urutan 4 — hanya aktif kalau MS terisi)
  $('santriSelect').addEventListener('change',e=>onSantriSwitch(e.target.value));
  $('santriManageBtn').addEventListener('click',openSantriMgmt);
  $('sd-close').addEventListener('click',()=>santriDlg.close());
  $('sd-add').addEventListener('click',addSantriFromDlg);
  $('sd-new-name').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();addSantriFromDlg();}});
  $('santriMgmtList').addEventListener('click',e=>{
    const row=e.target.closest('[data-sid]');if(!row)return;
    const id=row.dataset.sid;
    if(e.target.closest('[data-sd-rename]')){santriEditingId=id;renderSantriMgmt();}
    else if(e.target.closest('[data-sd-save]')){saveSantriRename(id);}
    else if(e.target.closest('[data-sd-cancel]')){santriEditingId=null;renderSantriMgmt();}
    else if(e.target.closest('[data-sd-del]')){deleteSantri(id);}
  });
  // Rekap
  document.querySelectorAll('input[name="r-mode"]').forEach(r=>r.addEventListener('change',()=>{ui.rmode=r.value;renderRekap();}));
  MONTHS.forEach((m,i)=>{const o=document.createElement('option');o.value=String(i);o.textContent=m;$('rMonth').appendChild(o);});
  $('rPrev').addEventListener('click',()=>{if(ui.ryear>2000){ui.ryear--;renderRekap();}});
  $('rNext').addEventListener('click',()=>{if(ui.ryear<new Date().getFullYear()){ui.ryear++;renderRekap();}});
  $('rMonth').addEventListener('change',e=>{ui.rmonth=Number(e.target.value);renderRekap();});
  document.querySelectorAll('input[name="r-metric"]').forEach(r=>r.addEventListener('change',()=>{ui.rmetric=r.value;renderRekap();}));
  $('rRapotPdf').addEventListener('click',()=>generateRapotPdf());
  let rz=null;
  window.addEventListener('resize',()=>{clearTimeout(rz);rz=setTimeout(()=>{if(ui.view==='rekap')renderRekap();if(ui.view==='dash')renderDash();},180);});
  // Cadangan
  $('statusGear').addEventListener('click',async()=>{
    const v=await ask({title:'Pengaturan',body:'Pilih yang ingin diubah. Data yang sudah tersimpan tidak akan hilang.',
      actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Ganti nama',value:'name',kind:''},{label:'Ganti metode penyimpanan',value:'method',kind:'primary'}]});
    if(v==='method')changeAuthMethod();
    else if(v==='name')changeUserName();
  });
  $('bkChangeMethod').addEventListener('click',async()=>{
    const v=await ask({title:'Ganti metode penyimpanan?',body:'Halaman akan dimuat ulang untuk memilih metode penyimpanan baru. Data yang sudah tersimpan tidak akan hilang.',
      actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Lanjutkan',value:'go',kind:'primary'}]});
    if(v==='go')changeAuthMethod();
  });
  $('bkChangeName').addEventListener('click',async()=>{
    const v=await ask({title:'Ganti nama?',body:'Halaman akan dimuat ulang untuk mengisi nama panggilan baru. Data yang sudah tersimpan tidak akan hilang.',
      actions:[{label:'Batal',value:null,kind:'ghost'},{label:'Lanjutkan',value:'go',kind:'primary'}]});
    if(v==='go')changeUserName();
  });
  $('bkExport').addEventListener('click',exportData);
  $('bkImport').addEventListener('click',()=>$('bkFile').click());
  $('bkFile').addEventListener('change',async e=>{
    const f=e.target.files&&e.target.files[0];e.target.value='';
    if(!f)return;
    try{importText(await f.text());}catch(err){toast('File tidak bisa dibaca');}
  });
  $('bkFromText').addEventListener('click',()=>{const t=$('bkText').value.trim();if(!t){toast('Tempel teks cadangan dulu');return;}importText(t);});
  // Sinkron saat tab dibuka kembali
  document.addEventListener('visibilitychange',async()=>{
    if(document.visibilityState!=='visible'||(Persist.mode!=='db'&&Persist.mode!=='sheets')||flushing||dirty.size||!$('boot').hidden)return;
    try{
      const d=await loadAll();
      const sigRec=o=>JSON.stringify([(o.quran||[]).map(x=>x.id).sort(),(o.matan||[]).map(x=>x.id+x.title+x.total).sort(),(o.matanLog||[]).map(x=>x.id).sort()]);
      if(isMultiSantriState(d)){
        const sigMulti=m=>JSON.stringify([m.activeSantriId,m.santriList.map(s=>s.id+'|'+s.nama).sort(),Object.keys(m.santriData).sort().map(id=>sigRec(m.santriData[id]))]);
        if(MS&&sigMulti(d)===sigMulti(MS))return;
        if(!flushing&&!dirty.size){applyState(d);renderAll();renderSantriBar();}
      }else if(!MS&&!flushing&&!dirty.size&&sigRec(d)!==sigRec(S)){
        applyState(d);renderAll();
      }
    }catch(e){}
  });
  window.addEventListener('beforeunload',e=>{if(dirty.size||flushing){e.preventDefault();e.returnValue='';}});
  // Tahap 4: begitu koneksi kembali, coba sinkron ulang otomatis kalau status
  // sebelumnya memang "internet bermasalah" — pengguna tidak perlu ingat
  // menekan "Coba lagi" sendiri.
  window.addEventListener('online',()=>{if(saveState==='error'&&dirty.size)scheduleFlush();});
}

/* ---------- Mulai ---------- */
async function boot(){
  $('bootRetry').hidden=true;$('bootMsg').textContent='Memuat catatan hafalan…';$('boot').hidden=false;
  await initPersist();
  await resolveUserName();
  await resolveSantriSetup();
  try{
    const d=await loadAll();
    if(PendingFirstSantriMS&&!isMultiSantriState(d)){
      applyState(PendingFirstSantriMS);
      PendingFirstSantriMS=null;
      markDirty('santri-meta');
    }else{
      applyState(d);
    }
  }
  catch(e){
    $('bootMsg').textContent=Persist.mode==='sheets'
      ?'Sheet belum bisa dibuka. Periksa URL Apps Script atau izin akses, lalu coba lagi. Kamu belum kehilangan apa pun.'
      :'Data belum bisa dimuat. Kamu belum kehilangan apa pun. Periksa koneksi, lalu coba lagi.';
    $('bootRetry').hidden=false;return;
  }
  const t=todayS();
  qEl.date.value=t;qEl.date.max=t;mEl.date.value=t;mEl.date.max=t;
  prefillQuran();
  renderAll();
  renderSantriBar();
  setSave('saved');
  $('boot').hidden=true;
  if(Persist.mode==='local')toast('Data disimpan di browser ini saja');
  else if(Persist.mode==='memory')toast('Data tidak bisa disimpan permanen di sini');
  else if(Persist.mode==='sheets')toast('Tersambung ke Google Sheet kamu');
}
bind();
$('bootRetry').addEventListener('click',boot);
boot();
})();
</script>
</body>
</html>
